---
// wnba-redesign/astro/components/wnba/WnbaTeamCard.astro
//
// Detailed tracker card on the bone interlude. White surface with team-
// color left rail, crest + city/shortName + conference/expansion tag, plus
// a 3-up stat row (record / streak / last 10).
//
// Locked variant: detailed (only). The prototype's "minimal" pill card
// was rejected.

import type { WNBATeamConfig } from '../../data/shared/types';
import type { WNBAStanding } from '../../data/wnba/types';
import WnbaCrest from './WnbaCrest.astro';

interface Props {
  team: WNBATeamConfig;
  /** This team's standings row; pass null if standings haven't loaded yet. */
  standing: WNBAStanding | null;
}
const { team, standing } = Astro.props;

const record =
  standing ? { w: standing.wins, l: standing.losses } : { w: 0, l: 0 };
const streak = standing?.streak ?? '—';
const last10 = standing?.last_10 ?? '—';
const isWinStreak = typeof streak === 'string' && streak.startsWith('W');
---
<a href={`/wnba/${team.slug}`} class="block group rounded-sm transition-colors relative overflow-hidden bg-white hover:bg-bone-2 border border-ink/[0.08]">
  {/* Team-color left rail */}
  <div class="absolute left-0 top-0 bottom-0 w-1.5" style={`background:${team.color};`}></div>

  <div class="p-4 pl-5">
    {/* Crest + city/name + arrow */}
    <div class="flex items-start justify-between gap-3 mb-3.5">
      <span class="flex items-center gap-3 min-w-0">
        <WnbaCrest team={team} size={38} />
        <span class="min-w-0">
          <span class="block text-[10px] uppercase tracking-[0.16em] text-ink/50 whitespace-nowrap">{team.city}</span>
          <span class="block font-court font-black text-ink text-2xl uppercase leading-tight">{team.shortName}</span>
          <span class="block text-[9px] uppercase tracking-[0.16em] text-lane mt-0.5">
            {team.conference}{team.expansion ? ` · New in '26` : ''}
          </span>
        </span>
      </span>
      <span class="text-ink/30 group-hover:text-lane group-hover:translate-x-0.5 transition-all text-lg leading-none">→</span>
    </div>

    {/* 3-up stat row */}
    <div class="grid grid-cols-3 gap-2 pt-3 border-t border-ink/[0.08]">
      <div>
        <div class="font-court font-black text-ink text-2xl leading-none tabular-nums">
          <span>{record.w}</span><span class="text-ink/30">–</span><span>{record.l}</span>
        </div>
        <div class="text-[9px] font-court font-black uppercase tracking-[0.18em] text-ink/45 mt-1.5">Record</div>
      </div>
      <div>
        <div class:list={['font-court font-black text-2xl leading-none tabular-nums', isWinStreak ? 'text-ink' : 'text-lane']}>
          {streak}
        </div>
        <div class="text-[9px] font-court font-black uppercase tracking-[0.18em] text-ink/45 mt-1.5">Streak</div>
      </div>
      <div>
        <div class="font-court font-black text-ink/80 text-2xl leading-none tabular-nums">{last10}</div>
        <div class="text-[9px] font-court font-black uppercase tracking-[0.18em] text-ink/45 mt-1.5">Last 10</div>
      </div>
    </div>
  </div>
</a>
