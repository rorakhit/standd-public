---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import TeamTrackerSubNav from '../../../components/TeamTrackerSubNav.astro';
import Footer from '../../../components/Footer.astro';
import { team as atlantaDream } from '../../../data/teams/wnba/atlanta-dream';
import { team as chicagoSky } from '../../../data/teams/wnba/chicago-sky';
import { team as connecticutSun } from '../../../data/teams/wnba/connecticut-sun';
import { team as dallasWings } from '../../../data/teams/wnba/dallas-wings';
import { team as goldenStateValkyries } from '../../../data/teams/wnba/golden-state-valkyries';
import { team as indianaFever } from '../../../data/teams/wnba/indiana-fever';
import { team as lasVegasAces } from '../../../data/teams/wnba/las-vegas-aces';
import { team as losAngelesSparks } from '../../../data/teams/wnba/los-angeles-sparks';
import { team as minnesotaLynx } from '../../../data/teams/wnba/minnesota-lynx';
import { team as newYorkLiberty } from '../../../data/teams/wnba/new-york-liberty';
import { team as phoenixMercury } from '../../../data/teams/wnba/phoenix-mercury';
import { team as seattleStorm } from '../../../data/teams/wnba/seattle-storm';
import { team as washingtonMystics } from '../../../data/teams/wnba/washington-mystics';
import { team as portlandFire } from '../../../data/teams/wnba/portland-fire';
import { team as torontoTempo } from '../../../data/teams/wnba/toronto-tempo';
import type { TeamConfig } from '../../../data/shared/types';
import { getTeamSchedule } from '../../../data/wnba/queries';

const allTeams: TeamConfig[] = [
  atlantaDream, chicagoSky, connecticutSun, dallasWings,
  goldenStateValkyries, indianaFever, lasVegasAces, losAngelesSparks,
  minnesotaLynx, newYorkLiberty, phoenixMercury, portlandFire,
  seattleStorm, torontoTempo, washingtonMystics,
];

export function getStaticPaths() {
  return [
    'atlanta-dream', 'chicago-sky', 'connecticut-sun', 'dallas-wings',
    'golden-state-valkyries', 'indiana-fever', 'las-vegas-aces', 'los-angeles-sparks',
    'minnesota-lynx', 'new-york-liberty', 'phoenix-mercury', 'portland-fire',
    'seattle-storm', 'toronto-tempo', 'washington-mystics',
  ].map(slug => ({ params: { team: slug } }));
}

const { team: teamSlug } = Astro.params;
const team = allTeams.find(t => t.slug === teamSlug)!;

const d1Games = await getTeamSchedule(teamSlug);
const allMatches = d1Games.map(g => ({
  date: g.date,
  homeAway: g.home_team === teamSlug ? ('home' as const) : ('away' as const),
  opponent: allTeams.find(t => t.slug === (g.home_team === teamSlug ? g.away_team : g.home_team))?.name
    ?? (g.home_team === teamSlug ? g.away_team : g.home_team),
  broadcast: g.broadcast,
}));
const today = new Date().toISOString().slice(0, 10);
const upcomingMatches = allMatches.filter(m => m.date >= today);
const visibleMatches = upcomingMatches.slice(0, 5);
const hiddenMatches = [...allMatches.filter(m => m.date < today), ...upcomingMatches.slice(5)];
const hiddenCount = hiddenMatches.length;

function formatDate(iso: string): string {
  const d = new Date(iso + 'T12:00:00Z');
  return d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
}

const services = [
  {
    name: 'ION',
    badge: 'Free',
    badgeClass: 'bg-accent text-primary',
    description: 'ION carries 50 WNBA games in 2026, the most of any single broadcaster, all on Friday nights. It\'s a free broadcast channel available via TV antenna, cable, and satellite. Check your local listings for the channel number.',
    link: null,
    linkLabel: null,
  },
  {
    name: 'USA Network',
    badge: 'Cable or streaming',
    badgeClass: 'bg-primary/10 text-primary',
    description: 'USA Network airs 48 WNBA games in 2026, the second-highest total of any broadcaster. Available with most cable and satellite packages, or via streaming services like Peacock and Sling.',
    link: null,
    linkLabel: null,
  },
  {
    name: 'Amazon Prime Video',
    badge: '$14.99/mo or Prime',
    badgeClass: 'bg-primary/10 text-primary',
    description: 'Amazon Prime Video carries 30 WNBA games in 2026, primarily on Thursday nights. Included with an Amazon Prime subscription ($14.99/month) — no sports add-on needed.',
    link: 'https://www.amazon.com/amazonprime',
    linkLabel: 'See Prime plans →',
  },
  {
    name: 'ABC / ESPN',
    badge: 'Cable or $12.99+/mo',
    badgeClass: 'bg-primary/10 text-primary',
    description: '30 games air on ABC and ESPN in 2026 (13 on ABC, 17 on ESPN). ABC is free over-the-air. Stream ESPN via ESPN Select ($12.99/mo) or ESPN Unlimited ($29.99/mo).',
    link: 'https://plus.espn.com/',
    linkLabel: 'See ESPN plans →',
  },
  {
    name: 'CBS / Paramount+',
    badge: 'Cable or streaming',
    badgeClass: 'bg-primary/10 text-primary',
    description: 'CBS Sports airs 20 WNBA games in 2026 — 8 in primetime on Saturday nights on CBS, the rest on CBS and Paramount+. CBS is free over-the-air; Paramount+ starts at $7.99/month.',
    link: 'https://www.paramountplus.com/',
    linkLabel: 'See Paramount+ plans →',
  },
  {
    name: 'NBC / Peacock',
    badge: 'Free or $7.99+/mo',
    badgeClass: 'bg-primary/10 text-primary',
    description: '7 games air on NBC on Sunday afternoons (free over-the-air). 15 more games air on Peacock and NBCSN, primarily Monday nights. Peacock starts at $7.99/month.',
    link: 'https://www.peacocktv.com/',
    linkLabel: 'See Peacock plans →',
  },
  {
    name: 'WNBA League Pass',
    badge: '$14.99/mo or $39.99/yr',
    badgeClass: 'bg-primary/10 text-primary',
    description: 'WNBA League Pass covers out-of-market regular season games. Subject to blackouts for nationally televised games. Best for fans who want to watch every game regardless of market.',
    link: 'https://www.wnba.com/leaguepass',
    linkLabel: 'See League Pass plans →',
  },
];

const title = `How to watch ${team.name} 2026 — broadcast info and streaming`;
const description = `Where every ${team.name} WNBA game airs in 2026. ION, USA Network, Amazon Prime Video, ABC, ESPN, CBS, NBC, and WNBA League Pass — full schedule and pricing below.`;
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": `${team.name} 2026 WNBA Broadcast Schedule`,
    "itemListElement": allMatches.slice(0, 20).map((match, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "item": {
        "@type": "SportsEvent",
        "name": match.homeAway === 'home'
          ? `${team.name} vs ${match.opponent}`
          : `${match.opponent} vs ${team.name}`,
        "startDate": match.date,
        "sport": "Basketball",
        "homeTeam": match.homeAway === 'home'
          ? { "@type": "SportsTeam", "name": team.name }
          : { "@type": "SportsTeam", "name": match.opponent },
        "awayTeam": match.homeAway === 'away'
          ? { "@type": "SportsTeam", "name": team.name }
          : { "@type": "SportsTeam", "name": match.opponent },
        "organizer": { "@type": "SportsOrganization", "name": "WNBA" },
        ...(match.broadcast?.length ? {
          "broadcastOfEvent": match.broadcast.map((b: string) => ({
            "@type": "BroadcastEvent",
            "broadcastDisplayName": b
          }))
        } : {})
      }
    }))
  })} />
  <Header />
  <TeamTrackerSubNav leagueSlug="wnba" teamSlug={team.slug} showHowToWatch />

  <main class="flex-1 max-w-3xl mx-auto px-6 py-12">
    <header class="mb-10">
      <p class="text-sm font-medium text-muted uppercase tracking-wider mb-3">{team.name} · 2026 Season</p>
      <h1 class="font-display font-bold text-4xl md:text-5xl text-primary leading-[1.1] mb-6">
        How to watch {team.name}
      </h1>
      <p class="text-lg leading-relaxed text-primary/80">
        WNBA games in 2026 are spread across seven broadcasters: ION (50 games), USA Network (48), Amazon Prime Video (30), ABC/ESPN (30), CBS/Paramount+ (20), and NBC/Peacock (22). ION, ABC, CBS, and NBC are free over-the-air. WNBA League Pass covers out-of-market games not on national TV.
      </p>
    </header>

    <section class="mb-12">
      <h2 class="font-display font-bold text-2xl text-primary mb-4">Where to watch</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 items-start" id="services-grid">
        {services.map((service, index) => (
          <div class="service-card border border-primary/15 rounded-lg overflow-hidden">
            <button
              class="service-toggle w-full flex items-center justify-between p-4 text-left hover:bg-primary/5 transition-colors"
              aria-expanded="false"
              aria-controls={`service-details-${index}`}
            >
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-display font-bold text-base text-primary">{service.name}</span>
                <span class={`text-xs font-bold uppercase tracking-wide px-2 py-0.5 rounded-full ${service.badgeClass}`}>{service.badge}</span>
              </div>
              <span class="service-chevron text-muted flex-shrink-0 ml-2 transition-transform duration-300">↓</span>
            </button>
            <div
              id={`service-details-${index}`}
              class="service-details"
              style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease;"
              aria-hidden="true"
            >
              <div class="px-4 pb-4 pt-1 border-t border-primary/10">
                <p class="text-sm text-primary/80 leading-relaxed">{service.description}</p>
                {service.link && (
                  <a href={service.link} target="_blank" rel="noopener noreferrer"
                    class="inline-block mt-3 text-xs font-bold text-accent hover:underline">
                    {service.linkLabel}
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-12">
      <h2 class="font-display font-bold text-2xl text-primary mb-4">Match-by-match broadcast schedule</h2>
      {allMatches.length === 0 ? (
        <p class="text-muted text-sm">Schedule coming soon — check back after the data fetch runs.</p>
      ) : (
        <>
          <div class="overflow-x-auto bg-neutral border border-primary/15 rounded-xl">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-primary/15 text-primary/60 text-left">
                  <th class="px-4 py-3 font-medium">Date</th>
                  <th class="px-4 py-3 font-medium">Game</th>
                  <th class="px-4 py-3 font-medium">Where</th>
                </tr>
              </thead>
              <tbody>
                {visibleMatches.map(match => (
                  <tr class="border-b border-primary/10">
                    <td class="px-4 py-3 tabular text-primary">{formatDate(match.date)}</td>
                    <td class="px-4 py-3 text-primary">{match.homeAway === 'home' ? 'vs ' : 'at '}{match.opponent}</td>
                    <td class="px-4 py-3 text-muted">{match.broadcast.length > 0 ? match.broadcast.join(', ') : 'TBD'}</td>
                  </tr>
                ))}
              </tbody>
              <tbody id="hidden-matches" style="display: none;">
                {hiddenMatches.map(match => (
                  <tr class="border-b border-primary/10 last:border-0">
                    <td class="px-4 py-3 tabular text-primary">{formatDate(match.date)}</td>
                    <td class="px-4 py-3 text-primary">{match.homeAway === 'home' ? 'vs ' : 'at '}{match.opponent}</td>
                    <td class="px-4 py-3 text-muted">{match.broadcast.length > 0 ? match.broadcast.join(', ') : 'TBD'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {hiddenCount > 0 && (
            <button id="show-more-btn" class="mt-3 text-sm font-bold text-primary/60 hover:text-primary transition-colors">
              Show all {hiddenCount} more games ↓
            </button>
          )}
          <p class="mt-3 text-xs text-muted">
            Broadcast assignments can change. Double-check on wnba.com or the broadcaster's site closer to tip-off.
          </p>
        </>
      )}
    </section>

    <footer class="mt-16 pt-8 border-t border-primary/15 text-sm text-muted">
      <p>← <a href={`/wnba/${team.slug}`} class="text-primary hover:text-accent transition-colors">Back to {team.name} tracker</a></p>
    </footer>
  </main>

  <Footer />
</BaseLayout>

<script>
  document.querySelectorAll('.service-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.service-card') as HTMLElement;
      const details = card.querySelector('.service-details') as HTMLElement;
      const chevron = btn.querySelector('.service-chevron') as HTMLElement;
      const isOpen = details.style.maxHeight !== '0px' && details.style.maxHeight !== '';
      if (isOpen) {
        details.style.maxHeight = '0';
        chevron.style.transform = 'rotate(0deg)';
        btn.setAttribute('aria-expanded', 'false');
        details.setAttribute('aria-hidden', 'true');
      } else {
        details.style.maxHeight = details.scrollHeight + 'px';
        chevron.style.transform = 'rotate(180deg)';
        btn.setAttribute('aria-expanded', 'true');
        details.setAttribute('aria-hidden', 'false');
      }
    });
  });

  const showMoreBtn = document.getElementById('show-more-btn') as HTMLElement | null;
  const hiddenMatches = document.getElementById('hidden-matches') as HTMLElement | null;
  if (showMoreBtn && hiddenMatches) {
    const hiddenCount = hiddenMatches.querySelectorAll('tr').length;
    showMoreBtn.addEventListener('click', () => {
      const isHidden = hiddenMatches.style.display === 'none';
      hiddenMatches.style.display = isHidden ? '' : 'none';
      showMoreBtn.textContent = isHidden
        ? 'Show fewer ↑'
        : `Show all ${hiddenCount} more games ↓`;
    });
  }
</script>
