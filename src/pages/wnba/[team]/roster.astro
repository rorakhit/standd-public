        </div>
      )}
    </div>
  </div>

  <div class="roster-body-wrap" style={`--team-color: ${teamColor};`}>
  <main class="roster-page">

    {roster.length === 0 ? (
      <div class="empty">
        <h2>Roster coming soon</h2>
        <p>
          Player data is on the way. Visit the{' '}
          <a href={team.officialUrl} target="_blank" rel="noopener noreferrer">official {team.name} site</a>{' '}
          for the current roster.
        </p>
      </div>
    ) : (
      <>
        <!-- Stat leaders strip -->
        {leaders.length > 0 && (
          <section class="leaders" aria-label="Team stat leaders">
            <div class="leaders-inner">
            <p class="leaders-label">{SEASON_LIVE ? `${currentYear} Season Leaders` : `${currentYear - 1} Season Leaders`}</p>
            <div class="leaders-grid" id="leaders-grid">
              {leaders.map(({ stat, result }) => {
                if (!result) return null;
                const { player, value } = result;
                const displayVal = stat === 'PPG' || stat === 'RPG' || stat === 'APG' || stat === 'SPG' || stat === 'BPG'
                  ? value.toFixed(1)
                  : value.toFixed(1);
                return (
                  <button
                    class="leader-cell"
                    data-open-player={player.espn_id}
                    style="text-align:left;"
                  >
                    <p class="leader-stat-label" data-tip={statTips[stat]} style={`color: ${teamColor}; cursor: help;`}>{stat} leader</p>
                    <div class="leader-value">{displayVal}</div>
                    <div>
                      <p class="leader-name">{player.name}</p>
                      <p class="leader-meta">#{player.num} · {player.posLong}</p>
                    </div>
                  </button>
                );
              })}
            </div>
            </div>
          </section>
        )}

        <!-- Toolbar -->
        <div class="toolbar">
          <div class="toolbar-left">
            <!-- Position filter -->
            <div class="pill-group" role="group" aria-label="Filter by position">
              <button class="pill active" data-pos="all">All</button>
              <button class="pill" data-pos="G">Guards</button>
              <button class="pill" data-pos="F">Forwards</button>
              <button class="pill" data-pos="C">Centers</button>
            </div>
            <!-- Split toggle -->
            <div class="pill-group split-toggle" role="group" aria-label="Stat split">
              <button class="pill active" data-split="season">2026</button>
              <button class="pill" data-split="career">Career</button>
            </div>
          </div>
          <div class="toolbar-right">
            <!-- Search -->
            <input
              type="search"
              class="search-input"
              placeholder="Search players…"
              id="roster-search"
              aria-label="Search players"
            />
            <!-- View toggle -->
            <div class="view-toggle" role="group" aria-label="View mode">
              <button class="view-btn active" data-view="cards" title="Cards view">⊞</button>
              <button class="view-btn" data-view="table" title="Table view">≡</button>
            </div>
          </div>
        </div>

        <!-- Cards view -->
        <div id="view-cards">
          <ul class="cards-grid" id="cards-grid" style="list-style:none;padding:0;margin:0;">
            {players.map(p => {
              const initials = p.name.trim().split(/\s+/).map((w: string) => w[0]).join('').slice(0, 2).toUpperCase();
              return (
                <li
                  class="roster-card"
                  data-slug={p.espn_id}
                  data-pos={p.pos}
                  data-name={p.name.toLowerCase()}
                  data-num={p.num}
                >
                  <div class="card-top">
                    <img
                      src={p.photo}
                      alt={p.name}
                      width="48" height="48"
                      class="card-avatar"
                      onerror="this.style.display='none';this.nextElementSibling.style.display='grid'"
                    />
                    <div
                      class="card-avatar-fallback"
                      style={`display:none;background:color-mix(in srgb, ${teamColor} 16%, var(--color-neutral));border:1px solid color-mix(in srgb, ${teamColor} 30%, transparent);`}
                      aria-hidden="true"
                    >{initials}</div>
                    <div style="min-width:0;flex:1;overflow:hidden;">
                      <div style="display:flex;align-items:center;gap:6px;min-width:0;">
                        <span class="card-num" style={`color:${teamColor};flex-shrink:0;`}>
                          {p.num ? p.num.toString().padStart(2, '0') : '—'}
                        </span>
                        <span class="card-name">{p.name}</span>
                        {p.rookie && <span class="rookie-badge" style="flex-shrink:0;">Rookie</span>}
                      </div>
                      <div class="card-meta">
                        <span>{p.posLong}</span>
                        {p.ht && p.ht !== '—' && <><span style="opacity:0.4">·</span><span>{p.ht}</span></>}
                        {p.college && p.college !== '—' && <><span style="opacity:0.4">·</span><span>{p.college}</span></>}
                      </div>
                    </div>
                  </div>
                  <!-- Stat strip -->
                  <div class="card-stats">
                    {[
                      { l: 'PPG', s: fmt(p.season.ppg), c: fmt(p.career.ppg) },
                      { l: 'RPG', s: fmt(p.season.rpg), c: fmt(p.career.rpg) },
                      { l: 'APG', s: fmt(p.season.apg), c: fmt(p.career.apg) },
                      { l: 'FG%', s: fmtPct(p.season.fgp), c: fmtPct(p.career.fgp) },
                      { l: '3P%', s: fmtPct(p.season.tpp), c: fmtPct(p.career.tpp) },
                    ].map(cell => (
                      <div class="card-stat-cell">
                        <div class="card-stat-val" data-season={cell.s} data-career={cell.c}>{cell.s}</div>
                        <div class="card-stat-lbl">{cell.l}</div>
                      </div>
                    ))}
                  </div>
                </li>
              );
            })}
          </ul>
        </div>

        <!-- Table view -->
        <div id="view-table" style="display:none;overflow-x:auto;">
          <div class="table-wrap">
            <table class="roster-table" id="roster-table">
              <thead>
                <tr>
                  <th class="left" data-col="num" style="padding-left:16px;">#<span class="sort-arrow" data-col="num"></span></th>
                  <th class="left" data-col="name" style="min-width:200px;">Player<span class="sort-arrow" data-col="name"></span></th>
                  <th class="center" data-col="pos" data-tip="Position (G = Guard, F = Forward, C = Center)">POS<span class="sort-arrow" data-col="pos"></span></th>
                  <th class="right" data-col="gp" data-tip="Games Played">GP<span class="sort-arrow" data-col="gp"></span></th>
                  <th class="right" data-col="mpg" data-tip="Minutes Per Game">MPG<span class="sort-arrow" data-col="mpg"></span></th>
                  <th class="right active" data-col="ppg" data-tip="Points Per Game">PPG<span class="sort-arrow" data-col="ppg">▼</span></th>
                  <th class="right" data-col="rpg" data-tip="Rebounds Per Game — offensive + defensive boards">RPG<span class="sort-arrow" data-col="rpg"></span></th>
                  <th class="right" data-col="apg" data-tip="Assists Per Game — passes that lead directly to a score">APG<span class="sort-arrow" data-col="apg"></span></th>
                  <th class="right" data-col="spg" data-tip="Steals Per Game — turnovers forced by the defender">SPG<span class="sort-arrow" data-col="spg"></span></th>
                  <th class="right" data-col="bpg" data-tip="Blocks Per Game — shots deflected at the rim">BPG<span class="sort-arrow" data-col="bpg"></span></th>
                  <th class="right" data-col="tov" data-tip="Turnovers Per Game — times possession is lost">TOV<span class="sort-arrow" data-col="tov"></span></th>
                  <th class="right" data-col="fgp" data-tip="Field Goal % — percentage of all shots made (2s and 3s)">FG%<span class="sort-arrow" data-col="fgp"></span></th>
                  <th class="right" data-col="tpp" data-tip="Three-Point % — percentage of shots made from beyond the arc">3P%<span class="sort-arrow" data-col="tpp"></span></th>
                  <th class="right" data-col="ftp" data-tip="Free Throw % — percentage of free throws made">FT%<span class="sort-arrow" data-col="ftp"></span></th>
                </tr>
              </thead>
              <tbody id="table-body">
                {players.sort((a, b) => (b.season.ppg ?? -1) - (a.season.ppg ?? -1)).map((p, i) => {
                  const initials = p.name.trim().split(/\s+/).map((w: string) => w[0]).join('').slice(0, 2).toUpperCase();
                  const rs = p.season;
                  const car = p.career;
                  return (
                    <tr
                      data-slug={p.espn_id}
                      data-pos={p.pos}
                      data-name={p.name.toLowerCase()}
                      data-num={p.num}
                      style={i % 2 === 0 ? `background:color-mix(in srgb, ${teamColor} 4%, transparent);` : ''}
                    >
                      <td class="td-num" style={`padding-left:16px;color:${teamColor};`}>{p.num || '—'}</td>
                      <td>
                        <div class="td-name">
                          <img
                            src={p.photo} alt={p.name}
                            width="36" height="36"
                            class="td-avatar"
                            onerror="this.style.display='none';this.nextElementSibling.style.display='grid'"
                          />
                          <div
                            class="td-avatar-fallback"
                            style={`display:none;background:color-mix(in srgb, ${teamColor} 16%, var(--color-neutral));border:1px solid color-mix(in srgb, ${teamColor} 30%, transparent);`}
                            aria-hidden="true"
                          >{initials}</div>
                          <div>
                            <div class="td-pname">
                              {p.name}
                              {p.rookie && <span class="rookie-badge" style="margin-left:6px;">Rookie</span>}
                            </div>
                            <div class="td-pmeta">{p.posLong}{p.ht && p.ht !== '—' ? ` · ${p.ht}` : ''}</div>
                          </div>
                        </div>
                      </td>
                      <td class="td-pos">{p.pos}</td>
                      <td class="td-stat" data-season={rs.gp ?? '—'} data-career={car.gp ?? '—'}>{rs.gp ?? '—'}</td>
                      <td class="td-stat" data-season={fmt(rs.mpg)} data-career={fmt(car.mpg)}>{fmt(rs.mpg)}</td>
                      <td class="td-stat td-stat-bold" data-season={fmt(rs.ppg)} data-career={fmt(car.ppg)}>{fmt(rs.ppg)}</td>
                      <td class="td-stat" data-season={fmt(rs.rpg)} data-career={fmt(car.rpg)}>{fmt(rs.rpg)}</td>
                      <td class="td-stat" data-season={fmt(rs.apg)} data-career={fmt(car.apg)}>{fmt(rs.apg)}</td>
                      <td class="td-stat" data-season={fmt(rs.spg)} data-career={fmt(car.spg)}>{fmt(rs.spg)}</td>
                      <td class="td-stat" data-season={fmt(rs.bpg)} data-career={fmt(car.bpg)}>{fmt(rs.bpg)}</td>
                      <td class="td-stat" data-season={fmt(rs.tov)} data-career={fmt(car.tov)}>{fmt(rs.tov)}</td>
                      <td class="td-stat" data-season={fmtPct(rs.fgp)} data-career={fmtPct(car.fgp)}>{fmtPct(rs.fgp)}</td>
                      <td class="td-stat" data-season={fmtPct(rs.tpp)} data-career={fmtPct(car.tpp)}>{fmtPct(rs.tpp)}</td>
                      <td class="td-stat" data-season={fmtPct(rs.ftp)} data-career={fmtPct(car.ftp)}>{fmtPct(rs.ftp)}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>

        <p style="margin-top:24px;font-size:12px;color:var(--color-muted);font-family:var(--font-mono);">
          Stats sourced from ESPN. Updated daily during the season.
        </p>
      </>
    )}
  </main>
  </div>

  <!-- Player modal -->
  <div id="modal-overlay" class="modal-overlay" role="dialog" aria-modal="true" aria-label="Player profile">
    <div class="modal-box" id="modal-box">
      <!-- Header band (team color) -->
      <div id="modal-header" class="modal-header" style={`background:${teamColor};`}>
        <div class="modal-controls">
          <button class="modal-ctrl-btn" id="modal-prev" title="Previous (←)">←</button>
          <button class="modal-ctrl-btn" id="modal-next" title="Next (→)">→</button>
          <button class="modal-ctrl-btn" id="modal-close" title="Close (Esc)">✕</button>
        </div>
        <p class="modal-eyebrow" id="modal-eyebrow">{team.name} · WNBA</p>
        <div class="modal-identity">
          <div id="modal-avatar-wrap">
            <img id="modal-avatar-img" class="modal-player-avatar" src="" alt="" width="120" height="120" />
            <div
              id="modal-avatar-fallback"
              class="modal-player-avatar-fallback"
              style={`display:none;background:color-mix(in srgb, ${teamColor} 40%, #000);`}
              aria-hidden="true"
            ></div>
          </div>
          <div>
            <h2 class="modal-name" id="modal-name">—</h2>
            <div class="modal-attrs" id="modal-attrs"></div>
