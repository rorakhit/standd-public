---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import TeamTrackerSubNav from '../../../components/TeamTrackerSubNav.astro';
import Footer from '../../../components/Footer.astro';
import { team } from '../../../data/teams/nwsl/racing-louisville.team';
import { getNwslTeamSchedule } from '../../../data/nwsl/queries';

const d1Games = await getNwslTeamSchedule(team.slug).catch(() => []);
const allMatches = d1Games.map(g => {
  const isHome = g.home_team === team.slug;
  const opponentSlug = isHome ? g.away_team : g.home_team;
  return {
    date: g.date,
    homeAway: (isHome ? 'home' : 'away') as 'home' | 'away',
    opponentSlug,
    opponent: opponentSlug,
    broadcast: g.broadcast,
    result: g.status === 'final' && g.home_score != null && g.away_score != null
      ? { teamScore: isHome ? g.home_score : g.away_score, opponentScore: isHome ? g.away_score : g.home_score }
      : undefined,
  };
}).sort((a, b) => a.date.localeCompare(b.date));
const today = new Date().toISOString().slice(0, 10);
const upcomingMatches = allMatches.filter(m => m.date >= today);
const visibleMatches = upcomingMatches.slice(0, 5);
const hiddenMatches = [...allMatches.filter(m => m.date < today), ...upcomingMatches.slice(5)];
const hiddenCount = hiddenMatches.length;

function formatDate(iso: string): string {
  const d = new Date(iso + 'T12:00:00Z');
  return d.toLocaleDateString('en-US', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
  });
}

const title = 'How to Watch Racing Louisville 2026 — TV & Streaming Guide';
const description = "Where every Racing Louisville match airs in 2026. NWSL+ (10 games), Victory+ (7), and ION carry the most games this season — full broadcast schedule and streaming pricing.";

const services = [
  {
    name: 'Victory+',
    badge: 'Free',
    badgeClass: 'bg-accent text-primary',
    description: 'Victory+ has 7 of 30 this season, a solid chunk of the schedule. Free, no subscription required.',
    link: 'https://victoryplus.com/hub/NWSL',
    linkLabel: 'Watch on Victory+ →',
  },
  {
    name: 'ION',
    badge: 'Free',
    badgeClass: 'bg-accent text-primary',
    description: 'ION carries 6 games this season on free over-the-air TV. Available via antenna, cable, and satellite. Check your local listings for the channel number.',
    link: null,
    linkLabel: null,
  },
  {
    name: 'NWSL+',
    badge: 'Free',
    badgeClass: 'bg-accent text-primary',
    description: "NWSL+ is the primary broadcaster this season — 10 of 30 on the league's own free streaming service. Download the app.",
    link: 'https://www.nwslsoccer.com/plus',
    linkLabel: 'Watch on NWSL+ →',
  },
  {
    name: 'ESPN / ESPN App',
    badge: 'Cable or $12.99+/mo',
    badgeClass: 'bg-primary/10 text-primary',
    description: 'ESPN picks up 2 games this season. Stream via the ESPN App with a cable TV provider login. ESPN Select is $12.99/month.',
    link: 'https://plus.espn.com/',
    linkLabel: 'See ESPN plans →',
  },
  {
    name: 'Prime Video',
    badge: '$14.99/mo',
    badgeClass: 'bg-primary/10 text-primary',
    description: 'Prime Video picks up 2 games this season. Included with a regular Prime subscription at $14.99/month, no sports add-on needed.',
    link: 'https://www.amazon.com/amazonprime',
    linkLabel: 'See Prime plans →',
  },

  {
    name: 'CBS Sports',
    badge: 'Cable / satellite',
    badgeClass: 'bg-primary/10 text-primary',
    description: 'CBS Sports Network has 4 games this season. Cable and satellite only. Some matches may also stream at cbssports.com with a TV provider login.',
    link: 'https://www.cbssports.com',
    linkLabel: 'Visit CBS Sports →',
  },
  {
    name: 'ABC / Disney+',
    badge: 'Free OTA or $11.99+/mo',
    badgeClass: 'bg-primary/10 text-primary',
    description: 'Marquee NWSL fixtures occasionally air on ABC with a simulcast on Disney+. None are currently scheduled for this team this season. Disney+ standalone starts at $11.99/month.',
    link: 'https://help.disneyplus.com/article/disneyplus-price',
    linkLabel: 'See Disney+ plans →',
  },
];
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": `${team.name} 2026 NWSL Broadcast Schedule`,
    "itemListElement": allMatches.slice(0, 20).map((match, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "item": {
        "@type": "SportsEvent",
        "name": match.homeAway === 'home'
          ? `${team.name} vs ${match.opponent}`
          : `${match.opponent} vs ${team.name}`,
        "startDate": match.date,
        "sport": "Soccer",
        "homeTeam": match.homeAway === 'home'
          ? { "@type": "SportsTeam", "name": team.name }
          : { "@type": "SportsTeam", "name": match.opponent },
        "awayTeam": match.homeAway === 'away'
          ? { "@type": "SportsTeam", "name": team.name }
          : { "@type": "SportsTeam", "name": match.opponent },
        "organizer": { "@type": "SportsOrganization", "name": "NWSL" },
        ...(match.broadcast?.length ? {
          "broadcastOfEvent": match.broadcast.map((b: string) => ({
            "@type": "BroadcastEvent",
            "broadcastDisplayName": b
          }))
        } : {})
      }
    }))
  })} />
  <Header />
  <TeamTrackerSubNav leagueSlug="nwsl" teamSlug="racing-louisville" showHowToWatch showFreeTV showSquad />

  <main class="flex-1 max-w-3xl mx-auto px-6 py-12">
    <header class="mb-10">
      <p class="text-sm font-medium text-muted uppercase tracking-wider mb-3">Racing Louisville · 2026 Season</p>
      <h1 class="font-display font-bold text-4xl md:text-5xl text-primary leading-[1.1] mb-6">
        How to watch Racing Louisville
      </h1>
      <p class="text-lg leading-relaxed text-primary/80">
        Racing Louisville are the NWSL+ team this season, 10 of 30 games on the league's free streaming service, more than any other club. Victory+ adds 7 more and ION has 6. Several games are on free over-the-air channels; <a href="/nwsl/racing-louisville/free-tv" class="text-accent hover:underline">see our guide to watching without cable</a>.
      </p>
    </header>

    <section class="mb-12">
      <h2 class="font-display font-bold text-2xl text-primary mb-4">Where to watch</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 items-start" id="services-grid">
        {services.map((service) => (
          <div class="service-card border border-primary/15 rounded-lg overflow-hidden">
            <button class="service-toggle w-full flex items-center justify-between p-4 text-left hover:bg-primary/5 transition-colors">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-display font-bold text-base text-primary">{service.name}</span>
                <span class={`text-xs font-bold uppercase tracking-wide px-2 py-0.5 rounded-full ${service.badgeClass}`}>{service.badge}</span>
              </div>
              <span class="service-chevron text-muted flex-shrink-0 ml-2 transition-transform duration-300">↓</span>
            </button>
            <div class="service-details" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease;">
              <div class="px-4 pb-4 pt-1 border-t border-primary/10">
                <p class="text-sm text-primary/80 leading-relaxed">{service.description}</p>
                {service.link && (
                  <a href={service.link} target="_blank" rel="noopener noreferrer"
                    class="inline-block mt-3 text-xs font-bold text-accent hover:underline">
                    {service.linkLabel}
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-12">
      <h2 class="font-display font-bold text-2xl text-primary mb-4">Match-by-match broadcast schedule</h2>
      <div class="overflow-x-auto bg-neutral border border-primary/15 rounded-xl">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-primary/15 text-primary/60 text-left">
              <th class="px-4 py-3 font-medium">Date</th>
              <th class="px-4 py-3 font-medium">Match</th>
              <th class="px-4 py-3 font-medium">Where</th>
            </tr>
          </thead>
          <tbody>
            {visibleMatches.map(match => (
              <tr class="border-b border-primary/10">
                <td class="px-4 py-3 tabular text-primary">{formatDate(match.date)}</td>
                <td class="px-4 py-3 text-primary"><a href={`/nwsl/${match.opponentSlug}`} class="hover:text-accent transition-colors">{match.homeAway === 'home' ? 'vs' : 'at'}{' '}{match.opponent}</a></td>
                <td class="px-4 py-3 text-muted">{match.broadcast.join(', ')}</td>
              </tr>
            ))}
          </tbody>
          <tbody id="hidden-matches" style="display: none;">
            {hiddenMatches.map(match => (
              <tr class="border-b border-primary/10 last:border-0">
                <td class="px-4 py-3 tabular text-primary">{formatDate(match.date)}</td>
                <td class="px-4 py-3 text-primary"><a href={`/nwsl/${match.opponentSlug}`} class="hover:text-accent transition-colors">{match.homeAway === 'home' ? 'vs' : 'at'}{' '}{match.opponent}</a></td>
                <td class="px-4 py-3 text-muted">{match.broadcast.join(', ')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <button id="show-more-btn" class="mt-3 text-sm font-bold text-primary/60 hover:text-primary transition-colors">
        Show all {hiddenCount} more matches ↓
      </button>
      <p class="mt-3 text-xs text-muted">
        Broadcast assignments can change. Double-check on NWSLsoccer.com or the broadcaster's site closer to kickoff.
      </p>
    </section>

    <footer class="mt-16 pt-8 border-t border-primary/15 text-sm text-muted">
      <p>← <a href="/nwsl/racing-louisville" class="text-primary hover:text-accent transition-colors">Back to Racing Louisville tracker</a></p>
    </footer>
  </main>

  <Footer />
</BaseLayout>

<script>
  document.querySelectorAll('.service-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.service-card') as HTMLElement;
      const details = card.querySelector('.service-details') as HTMLElement;
      const chevron = btn.querySelector('.service-chevron') as HTMLElement;
      const isOpen = details.style.maxHeight !== '0px' && details.style.maxHeight !== '';
      if (isOpen) {
        details.style.maxHeight = '0';
        chevron.style.transform = 'rotate(0deg)';
      } else {
        details.style.maxHeight = details.scrollHeight + 'px';
        chevron.style.transform = 'rotate(180deg)';
      }
    });
  });

  const showMoreBtn = document.getElementById('show-more-btn') as HTMLElement;
  const hiddenMatches = document.getElementById('hidden-matches') as HTMLElement;
  const hiddenCount = hiddenMatches.querySelectorAll('tr').length;
  showMoreBtn?.addEventListener('click', () => {
    const isHidden = hiddenMatches.style.display === 'none';
    hiddenMatches.style.display = isHidden ? '' : 'none';
    showMoreBtn.textContent = isHidden
      ? 'Show fewer ↑'
      : `Show all ${hiddenCount} more matches ↓`;
  });
</script>
