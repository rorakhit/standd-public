---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EmailSignup from '../components/EmailSignup.astro';

const title = 'About Standd';
const description = "Standd covers women's professional sports. Built by a fan, for fans. No data sales.";
---

<BaseLayout title={title} description={description}>
  <Header />

  <main class="flex-1">
    <section class="bg-cream pt-16 pb-12 border-b-[12px] border-accent">
      <div class="max-w-3xl mx-auto px-6">
        <p class="text-sm font-bold text-accent uppercase tracking-[0.2em] mb-4">About</p>
        <h1 class="font-display font-bold text-5xl md:text-7xl text-primary leading-[1.0] mb-8">
          Built by a fan.<br />For fans.
        </h1>
        <div class="space-y-5 text-lg leading-relaxed text-primary/80">
          <p>
            Standd covers women's professional sports — NWSL, WNBA, and more coming. Schedules, scores, standings, and player pages.
          </p>
          <p>
            I'm just a software developer who loves women's sports and I hope you find this useful.
          </p>
          <p class="text-primary/50 pt-2 text-base">
            — Ro &nbsp;·&nbsp; <a href="mailto:ro@standd.fan" class="text-accent font-bold hover:underline">ro@standd.fan</a>
          </p>
        </div>
      </div>
    </section>

    <EmailSignup />
  </main>

  <Footer />
</BaseLayout>
