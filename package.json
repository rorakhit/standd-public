{
  "name": "standd",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "prebuild": "node -e \"if(process.env.SKIP_DATA_FETCH!=='1')require('child_process').execSync('npm run refresh-data',{stdio:'inherit'})\"",
    "refresh-data": "tsx scripts/fetch-standings.ts && tsx scripts/fetch-schedule.ts && tsx scripts/fetch-nwsl-schedule.ts && tsx scripts/parse-nwsl-schedule.ts && tsx scripts/fetch-nwsl-rosters.ts && tsx scripts/fetch-wnba-schedule.ts && tsx scripts/parse-wnba-schedule.ts",
    "fetch-wnba": "tsx scripts/fetch-wnba-schedule.ts && tsx scripts/parse-wnba-schedule.ts",
    "fetch-rosters": "tsx scripts/fetch-nwsl-rosters.ts",
    "fetch-schedules": "tsx scripts/fetch-nwsl-schedule.ts && tsx scripts/parse-nwsl-schedule.ts",
    "preview": "astro preview",
    "astro": "astro",
    "sync-public": "bash scripts/sync-public.sh",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/sitemap": "^3.2.0",
    "@astrojs/tailwind": "^5.1.4",
    "@mendable/firecrawl-js": "^4.20.0",
    "astro": "^5.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "bmad-mcp-server": "^3.0.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5"
  }
}
