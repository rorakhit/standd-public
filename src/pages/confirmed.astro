---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'You\'re confirmed — Standd';
const description = 'Your email is confirmed. Welcome to standd.fan.';
---

<BaseLayout title={title} description={description} noindex={true}>
  <Header />

  <main class="flex-1">
    <section class="bg-cream py-24">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <p class="text-sm font-bold text-accent uppercase tracking-[0.2em] mb-4">You're confirmed</p>
        <h1 class="font-display font-bold text-5xl md:text-7xl text-primary leading-[1.0] mb-6">
          See you in your inbox.
        </h1>
        <p class="text-xl text-primary/70 leading-relaxed max-w-xl mx-auto mb-10">
          You'll hear from us after matches, when standings shift, and when something new lands on standd.fan.
        </p>
        <a
          href="/nwsl/boston-legacy"
          class="inline-block bg-accent text-primary font-display font-bold text-xl px-12 py-5 rounded-xl hover:bg-primary hover:text-neutral transition-colors"
        >
          Back to the tracker →
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
