---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EmailSignup from '../components/EmailSignup.astro';

const title = 'Standd — A fan companion for women\'s pro sports';

const comingSoon = [
  { title: 'WSL, PWHL.', subtitle: 'More leagues. One home.' },
  { title: 'Picks.', subtitle: 'Pick five faves a week. Across every league. No friend group required.' },
  { title: 'Your year, wrapped.', subtitle: 'Your Picks. Your hit rate. Your fandom, in receipts.' },
];
---

<BaseLayout title={title}>
  <Header />

  <main class="flex-1">
    <!-- Hero: cream → teal section with massive dd -->
    <section class="bg-neutral pt-12 pb-20 border-b-[12px] border-accent">
      <div class="max-w-5xl mx-auto px-6">
        <p class="text-sm font-bold text-accent uppercase tracking-[0.2em] mb-6">Now tracking · NWSL + WNBA · 2026</p>
        <div class="md:grid md:grid-cols-[auto_1fr] md:items-end md:gap-12">
          <div class="font-display font-bold leading-[0.85]">
            <div class="text-6xl md:text-8xl text-primary">stan</div>
            <div class="text-[9rem] md:text-[14rem] text-accent -mt-4 md:-mt-8 tracking-[-0.04em] ml-8 md:ml-16">dd</div>
          </div>
          <p class="mt-10 md:mt-0 md:pb-6 text-xl md:text-2xl text-primary leading-snug font-medium">
            A fan companion for women's professional sports. Schedules, scores, recaps, and more. Built by a fan, for fans.
          </p>
        </div>
      </div>
    </section>

    <!-- League grid: NWSL + WNBA -->
    <section class="bg-primary py-16">
      <div class="max-w-5xl mx-auto px-6">
        <p class="text-sm font-bold text-accent uppercase tracking-[0.2em] mb-6">Live now</p>
        <div class="grid md:grid-cols-2 gap-4">
          <a
            href="/nwsl"
            class="block bg-accent text-primary p-8 rounded-2xl hover:bg-neutral transition-colors group"
          >
            <div class="flex flex-col gap-4">
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary/60 mb-1">NWSL · 2026</p>
                <h2 class="font-display font-bold text-3xl md:text-4xl leading-tight">
                  National Women's Soccer League
                </h2>
                <p class="mt-2 text-base font-medium text-primary/80">
                  All 16 teams. Scores, fixtures, standings, squad pages.
                </p>
              </div>
              <span class="self-start text-4xl font-display font-bold leading-none text-primary group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
          <a
            href="/wnba"
            class="block text-neutral p-8 rounded-2xl hover:opacity-90 transition-opacity group"
            style="background-color: #E85D00;"
          >
            <div class="flex flex-col gap-4">
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-neutral/60 mb-1">WNBA · 2026</p>
                <h2 class="font-display font-bold text-3xl md:text-4xl leading-tight">
                  Women's National Basketball Association
                </h2>
                <p class="mt-2 text-base font-medium text-neutral/80">
                  All 15 teams. Schedules, broadcast info, player pages.
                </p>
              </div>
              <span class="self-start text-4xl font-display font-bold leading-none text-neutral group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Coming soon: vibrant cards with color rotation -->
    <section class="bg-neutral py-16">
      <div class="max-w-5xl mx-auto px-6">
        <p class="text-sm font-bold text-accent uppercase tracking-[0.2em] mb-2">Coming soon</p>
        <h2 class="font-display font-bold text-4xl md:text-5xl text-primary mb-10">What we're building.</h2>
        <ul class="grid md:grid-cols-2 gap-4">
          {comingSoon.map((item, i) => {
            // Rotating color treatments for visual rhythm
            const variants = [
              'bg-primary text-neutral hover:bg-accent hover:text-primary',
              'bg-accent text-primary hover:bg-primary hover:text-neutral',
              'bg-primary text-neutral hover:bg-accent hover:text-primary',
              'bg-accent text-primary hover:bg-primary hover:text-neutral',
            ];
            return (
              <li class={`p-6 rounded-2xl transition-colors ${variants[i % variants.length]}`}>
                <h3 class="font-display font-bold text-2xl md:text-3xl leading-tight">{item.title}</h3>
                <p class="mt-2 text-base md:text-lg opacity-80">{item.subtitle}</p>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
    <EmailSignup />
  </main>

  <Footer />
</BaseLayout>
