---
// Last card in the league grid — vote for what we cover next
---

<article class="rounded-2xl overflow-hidden bg-primary text-neutral flex flex-col relative min-h-[520px]">
  <div class="relative p-8 flex flex-col flex-1">

    <!-- Top row -->
    <div class="flex items-center justify-between">
      <span class="inline-flex items-center gap-1.5 bg-neutral/20 text-neutral text-[11px] font-bold uppercase tracking-[0.14em] px-2.5 py-1 rounded-full">
        Roadmap
      </span>
      <span class="text-[11px] font-bold uppercase tracking-[0.2em] text-neutral/60">
        Community
      </span>
    </div>

    <!-- Heading -->
    <div class="mt-5">
      <p class="font-display font-bold text-[4rem] leading-[0.88] tracking-[-0.04em] text-neutral">
        What's next? You tell me.
      </p>
    </div>

    <!-- Spacer — pushes subtitle + form to bottom -->
    <div class="flex-1"></div>

    <!-- Subtitle -->
    <p class="text-lg text-neutral/60 mb-4 font-medium leading-snug">
      Standd is a one-fan project — leagues come on as I can build them. Vote for what you want covered next.
    </p>

    <!-- Form state -->
    <div id="vgc-form-wrap">
      <form id="vgc-form" class="flex flex-col gap-2.5" autocomplete="off">
        <input
          id="vgc-input"
          type="text"
          name="entry"
          placeholder="Type a league…"
          required
          maxlength="200"
          class="w-full bg-neutral/10 text-neutral placeholder:text-neutral/40 rounded-xl px-4 py-3 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-accent/50"
        />
        <button
          type="submit"
          class="w-full bg-accent text-neutral font-display font-bold text-sm px-4 py-3 rounded-xl hover:opacity-90 active:scale-[0.98] transition-all"
        >
          Cast vote →
        </button>
      </form>
    </div>

    <!-- Results state -->
    <div id="vgc-results-wrap" class="hidden">
      <div class="flex items-center justify-between pb-2 mb-2 border-b border-dashed border-neutral/15">
        <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-neutral/60">Results</span>
        <span id="vgc-total" class="tabular text-[11px] text-neutral/40"></span>
      </div>
      <ol id="vgc-list" class="flex flex-col gap-1"></ol>
      <button
        id="vgc-again"
        class="mt-3 text-xs font-bold text-neutral/50 uppercase tracking-[0.14em] hover:text-neutral transition-colors"
      >
        Vote again
      </button>
    </div>


</div>

  <!-- Footer -->
  <div class="relative bg-black/20 px-8 py-3.5 flex items-center justify-between">
    <span class="text-[11px] font-bold uppercase tracking-[0.18em] [word-spacing:-0.12em] text-neutral/80">
      Cast your vote
    </span>
    <span class="font-display font-bold text-2xl leading-none text-neutral" aria-hidden="true">→</span>
  </div>
</article>

<script>
  const form        = document.getElementById('vgc-form')         as HTMLFormElement;
  const formWrap    = document.getElementById('vgc-form-wrap')    as HTMLDivElement;
  const input       = document.getElementById('vgc-input')        as HTMLInputElement;
  const resultsWrap = document.getElementById('vgc-results-wrap') as HTMLDivElement;
  const totalEl     = document.getElementById('vgc-total')        as HTMLSpanElement;
  const listEl      = document.getElementById('vgc-list')         as HTMLOListElement;
  const againBtn    = document.getElementById('vgc-again')        as HTMLButtonElement;

  function renderResults(votes: { entry: string; count: number }[]) {
    const total = votes.reduce((s, v) => s + v.count, 0);
    totalEl.textContent = `${total} vote${total === 1 ? '' : 's'}`;
    const max = votes[0]?.count ?? 1;
    listEl.innerHTML = votes.slice(0, 8).map(v => {
      const pct = Math.round((v.count / max) * 100);
      return `<li class="relative overflow-hidden rounded-lg">
        <div class="absolute inset-y-0 left-0 rounded-lg" style="width:${pct}%;background:rgba(250,246,240,0.08)"></div>
        <div class="relative flex items-center justify-between px-3 py-1.5">
          <span class="text-sm font-medium text-neutral">${v.entry}</span>
          <span class="tabular text-xs ml-4" style="color:rgba(250,246,240,0.45)">${v.count}</span>
        </div>
      </li>`;
    }).join('');
    formWrap.classList.add('hidden');
    resultsWrap.classList.remove('hidden');
  }

  form.addEventListener('submit', async e => {
    e.preventDefault();
    const entry = input.value.trim();
    if (!entry) return;
    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Counting…';
    try {
      const res = await fetch('/api/vote', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ entry }),
      });
      const { votes } = await res.json() as { votes: { entry: string; count: number }[] };
      renderResults(votes);
    } catch {
      btn.disabled = false;
      btn.textContent = 'Cast vote →';
    }
  });

  againBtn.addEventListener('click', () => {
    input.value = '';
    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.disabled = false;
    btn.textContent = 'Cast vote →';
    resultsWrap.classList.add('hidden');
    formWrap.classList.remove('hidden');
    input.focus();
  });
</script>
