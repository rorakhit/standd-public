---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import TeamTrackerSubNav from '../../../components/TeamTrackerSubNav.astro';
import Footer from '../../../components/Footer.astro';
import Broadcaster from '../../../components/Broadcaster.astro';
import { team as atlantaDream } from '../../../data/teams/wnba/atlanta-dream';
import { team as chicagoSky } from '../../../data/teams/wnba/chicago-sky';
import { team as connecticutSun } from '../../../data/teams/wnba/connecticut-sun';
import { team as dallasWings } from '../../../data/teams/wnba/dallas-wings';
import { team as goldenStateValkyries } from '../../../data/teams/wnba/golden-state-valkyries';
import { team as indianaFever } from '../../../data/teams/wnba/indiana-fever';
import { team as lasVegasAces } from '../../../data/teams/wnba/las-vegas-aces';
import { team as losAngelesSparks } from '../../../data/teams/wnba/los-angeles-sparks';
import { team as minnesotaLynx } from '../../../data/teams/wnba/minnesota-lynx';
import { team as newYorkLiberty } from '../../../data/teams/wnba/new-york-liberty';
import { team as phoenixMercury } from '../../../data/teams/wnba/phoenix-mercury';
import { team as seattleStorm } from '../../../data/teams/wnba/seattle-storm';
import { team as washingtonMystics } from '../../../data/teams/wnba/washington-mystics';
import { team as portlandFire } from '../../../data/teams/wnba/portland-fire';
import { team as torontoTempo } from '../../../data/teams/wnba/toronto-tempo';
import type { TeamConfig } from '../../../data/shared/types';
import { getTeamSchedule, getTeamStats, getStandings } from '../../../data/wnba/queries';

const allTeams: TeamConfig[] = [
  atlantaDream, chicagoSky, connecticutSun, dallasWings,
  goldenStateValkyries, indianaFever, lasVegasAces, losAngelesSparks,
  minnesotaLynx, newYorkLiberty, phoenixMercury, portlandFire,
  seattleStorm, torontoTempo, washingtonMystics,
];

export function getStaticPaths() {
  return [
    atlantaDream, chicagoSky, connecticutSun, dallasWings,
    goldenStateValkyries, indianaFever, lasVegasAces, losAngelesSparks,
    minnesotaLynx, newYorkLiberty, phoenixMercury, portlandFire,
    seattleStorm, torontoTempo, washingtonMystics,
  ].map(t => ({ params: { team: t.slug } }));
}

const { team: teamSlug } = Astro.params;
const team = allTeams.find(t => t.slug === teamSlug)!;

const [d1Games, teamStats, allStandings] = await Promise.all([
  getTeamSchedule(teamSlug),
  getTeamStats(teamSlug),
  getStandings(),
]);

const matches = d1Games.map(g => {
  const isHome = g.home_team === teamSlug;
  const opponentSlug = isHome ? g.away_team : g.home_team;
  const opponentTeam = allTeams.find(t => t.slug === opponentSlug);
  const opponentName = opponentTeam?.name ?? opponentSlug;
  return {
    date: g.date,
    time: g.time ?? undefined,
    opponent: opponentName,
    homeAway: isHome ? ('home' as const) : ('away' as const),
    venue: g.venue ?? undefined,
    broadcast: g.broadcast,
    result: g.status === 'final' && g.home_score != null && g.away_score != null
      ? {
          teamScore:     isHome ? g.home_score : g.away_score,
          opponentScore: isHome ? g.away_score : g.home_score,
        }
      : undefined,
  };
});

const playedMatches = matches.filter(m => m.result);
const upcomingMatches = matches.filter(m => !m.result);
const nextMatch = upcomingMatches[0];
const nextThreeFixtures = upcomingMatches.slice(0, 3);
const lastThreeResults = playedMatches.slice(-3).reverse();
const lastFiveResults = playedMatches.slice(-5).reverse();

const gamesPlayed = playedMatches.length;
const wins = playedMatches.filter(m => m.result && m.result.teamScore > m.result.opponentScore).length;
const losses = playedMatches.filter(m => m.result && m.result.teamScore < m.result.opponentScore).length;
const progressPct = matches.length > 0 ? Math.round((gamesPlayed / matches.length) * 100) : 0;

let streak = 0;
let streakLabel = '';
const reversed = [...playedMatches].reverse();
if (reversed.length > 0) {
  const firstResult = reversed[0].result!;
  const isWinStreak = firstResult.teamScore > firstResult.opponentScore;
  for (const m of reversed) {
    const r = m.result!;
    const isWin = r.teamScore > r.opponentScore;
    if (isWin === isWinStreak) streak++;
    else break;
  }
  streakLabel = isWinStreak ? `W${streak}` : `L${streak}`;
}

const teamStanding = allStandings.find(r => r.team === teamSlug);
const teamConference = teamStanding?.conference ?? null;
const conferenceRows = teamConference
  ? allStandings
      .filter(r => r.conference === teamConference)
      .sort((a, b) => (a.playoff_seed ?? 99) - (b.playoff_seed ?? 99))
  : [];

function formatDate(iso: string): string {
  const d = new Date(iso + 'T12:00:00Z');
  return d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
}

function formatScore(match: typeof matches[0]): string {
  if (!match.result) return '—';
  return `${match.result.teamScore}–${match.result.opponentScore}`;
}

function resultBadge(match: typeof matches[0]): { label: string; color: string; style?: string } {
  if (!match.result) return { label: '—', color: 'bg-muted/20 text-muted' };
  const { teamScore, opponentScore } = match.result;
  if (teamScore > opponentScore) return { label: 'W', color: 'text-neutral', style: 'background-color: var(--team-color)' };
  if (teamScore < opponentScore) return { label: 'L', color: 'bg-primary text-neutral' };
  return { label: 'D', color: 'bg-primary/20 text-primary' };
}

const seasonComplete = upcomingMatches.length === 0 && playedMatches.length > 0;

const title = `${team.name} 2026 Season Tracker — Standd`;
const description = `${team.name} WNBA 2026 season tracker — schedule, results, and broadcast info.`;
---

<style define:vars={{ teamColor: team.color }}>
  .tracker-body { --team-color: var(--teamColor); }
</style>

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SportsTeam",
    "name": team.name,
    "url": `https://standd.fan/wnba/${team.slug}`,
    "sport": "Basketball",
    "memberOf": {
      "@type": "SportsOrganization",
      "name": "Women's National Basketball Association",
      "alternateName": "WNBA",
      "url": "https://www.wnba.com/"
    },
    ...(team.badge ? { "logo": team.badge } : {}),
    "sameAs": [team.officialUrl]
  })} />
  <Header />
  <TeamTrackerSubNav leagueSlug="wnba" teamSlug={team.slug} showHowToWatch showPlayers />

  <main class="tracker-body flex-1">
    <!-- Hero header -->
    <section class="bg-neutral pt-12 pb-12 border-b-[12px]" style="border-color: var(--team-color)">
      <div class="max-w-3xl mx-auto px-6">
        <p class="text-sm font-bold uppercase tracking-[0.2em] mb-3" style="color: var(--team-color)">WNBA · 2026 Season</p>
        <div class="flex items-center gap-5 mb-6">
          {team.badge && <img src={team.badge} alt={team.name} width="72" height="72" class="flex-shrink-0 object-contain" />}
          <h1 class="font-display font-bold text-5xl md:text-7xl text-primary leading-[1.0]">
            {team.name}
          </h1>
        </div>

        {/* Season progress bar */}
        {matches.length > 0 && (
          <div class="mb-6">
            <div class="flex items-center justify-between text-xs text-muted font-bold uppercase tracking-wider mb-2">
              <span>{gamesPlayed} / {matches.length} games played</span>
              {streakLabel && <span>Current streak: {streakLabel}</span>}
            </div>
            <div class="h-2 bg-primary/10 rounded-full overflow-hidden">
              <div class="h-full rounded-full transition-all" style={`width: ${progressPct}%; background-color: var(--team-color)`} />
            </div>
            {gamesPlayed > 0 && (
              <p class="mt-2 text-sm text-muted">{wins}W · {losses}L</p>
            )}
          </div>
        )}

        {/* Next game hero */}
        {nextMatch && (
          <div class="rounded-2xl p-6 border-2 mt-4" style="border-color: var(--team-color)">
            <p class="text-xs font-bold uppercase tracking-wider text-muted mb-3">Next game</p>
            <div class="flex items-start justify-between gap-4 flex-wrap">
              <div>
                <p class="font-display font-bold text-2xl text-primary leading-tight">
                  {nextMatch.homeAway === 'home' ? 'vs ' : 'at '}{nextMatch.opponent}
                </p>
                <p class="mt-1 text-primary/70 text-sm">{formatDate(nextMatch.date)}{nextMatch.time ? ` · ${nextMatch.time} ET` : ''}</p>
                <p class="text-muted text-sm">{nextMatch.venue}</p>
                <div class="flex flex-wrap items-center gap-1.5 mt-2">
                  {nextMatch.broadcast.length > 0
                    ? nextMatch.broadcast.map(b => <Broadcaster name={b} />)
                    : <span class="text-xs text-muted">Broadcast TBD</span>
                  }
                </div>
              </div>
              {team.ticketsUrl && (
                <a
                  href={team.ticketsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-shrink-0 text-sm font-bold text-neutral px-4 py-2 rounded-full hover:opacity-80 transition-opacity"
                  style="background-color: var(--team-color)"
                >
                  Get tickets →
                </a>
              )}
            </div>
          </div>
        )}

        {seasonComplete && (
          <div class="rounded-2xl p-6 border-2 mt-4 border-primary/20">
            <p class="font-display font-bold text-xl text-primary">Season complete</p>
            <p class="text-muted text-sm mt-1">The 2026 WNBA season has concluded for {team.name}.</p>
          </div>
        )}

        {matches.length === 0 && (
          <div class="rounded-2xl p-6 border-2 mt-4 border-primary/20">
            <p class="text-muted">Schedule coming soon. Check back after the data fetch runs.</p>
          </div>
        )}

        {lastFiveResults.length > 0 && (
          <div class="mt-6 flex items-center gap-3">
            <span class="text-xs text-muted uppercase tracking-wider font-bold">Form</span>
            <div class="flex items-center gap-1.5">
              {lastFiveResults.map(m => {
                const b = resultBadge(m);
                return (
                  <span class={`inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-bold ${b.color}`} style={b.style ?? ''}>
                    {b.label}
                  </span>
                );
              })}
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- Next + Last results -->
    {(nextThreeFixtures.length > 0 || lastThreeResults.length > 0) && (
      <section class="bg-neutral py-16">
        <div class="max-w-5xl mx-auto px-6">
          <div class="grid md:grid-cols-2 gap-10">
            {nextThreeFixtures.length > 0 && (
              <div>
                <h2 class="font-display font-bold text-3xl text-primary mb-6">Next 3 games</h2>
                <ul class="space-y-3">
                  {nextThreeFixtures.map(match => {
                    const isHome = match.homeAway === 'home';
                    return (
                      <li class={`overflow-hidden rounded-xl flex min-h-[120px] ${isHome ? 'bg-primary text-neutral' : 'bg-neutral border-2 border-primary text-primary'}`}>
                        <div class="w-1.5 flex-shrink-0" style={`background-color: var(--team-color)`} />
                        <div class="flex flex-col gap-2 p-5 flex-1">
                          <div class="flex items-center justify-between">
                            <div class="flex items-baseline gap-2">
                              <span class={`font-display font-bold tabular text-lg ${isHome ? 'text-neutral/80' : 'text-primary/60'}`}>{formatDate(match.date)}</span>
                              {match.time && <span class={`font-display font-bold text-base ${isHome ? 'text-neutral/60' : 'text-primary/50'}`}>{match.time} ET</span>}
                            </div>
                            <span class={`text-xs uppercase tracking-wider font-bold px-2 py-1 rounded ${isHome ? 'bg-neutral/10 text-neutral/60' : 'bg-primary/10 text-primary/50'}`}>
                              {isHome ? 'HOME' : 'AWAY'}
                            </span>
                          </div>
                          <p class="font-display font-bold text-xl leading-tight">
                            {isHome ? 'vs ' : 'at '}{match.opponent}
                          </p>
                          <div class="mt-auto flex flex-wrap items-center gap-1.5">
                            {match.broadcast.length > 0
                              ? match.broadcast.map(b => <Broadcaster name={b} />)
                              : <span class={`text-xs ${isHome ? 'text-neutral/60' : 'text-muted'}`}>Broadcast TBD</span>
                            }
                          </div>
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </div>
            )}

            {lastThreeResults.length > 0 && (
              <div>
                <h2 class="font-display font-bold text-3xl text-primary mb-6">Last 3 results</h2>
                <ul class="space-y-3">
                  {lastThreeResults.map(match => {
                    const badge = resultBadge(match);
                    return (
                      <li class="bg-neutral border-2 border-primary p-5 rounded-xl flex flex-col gap-2 min-h-[120px]">
                        <div class="flex items-center justify-between">
                          <span class="font-display font-bold tabular text-primary text-lg">{formatDate(match.date)}</span>
                          <div class="flex items-center gap-2">
                            <span class={`text-xs font-display font-bold px-2 py-1 rounded ${badge.color}`} style={badge.style ?? ''}>
                              {badge.label}
                            </span>
                            <span class="font-display font-bold tabular text-2xl text-primary">
                              {formatScore(match)}
                            </span>
                          </div>
                        </div>
                        <p class="font-display font-bold text-xl text-primary leading-tight">
                          {match.homeAway === 'home' ? 'vs ' : 'at '}{match.opponent}
                        </p>
                        <span class="text-sm text-muted mt-auto">{match.venue}</span>
                      </li>
                    );
                  })}
                </ul>
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- Full schedule -->
    {upcomingMatches.length > 0 && (
      <section class="bg-neutral py-16">
        <div class="max-w-5xl mx-auto px-6">
          <div class="flex items-center gap-3 mb-2">
            <h2 class="font-display font-bold text-3xl text-primary">Full remaining schedule</h2>
            <button
              id="schedule-toggle"
              aria-expanded="false"
              aria-controls="schedule-list"
              aria-label="Toggle full schedule"
              class="hover:opacity-70 transition-opacity"
              style="color: var(--team-color)"
            >
              <span id="schedule-toggle-icon" class="block text-4xl leading-none" style="transition: transform 0.3s ease;">↓</span>
            </button>
          </div>
          <p class="text-muted text-sm mb-6">All upcoming {team.name} games this season.</p>
          <ul id="schedule-list" aria-hidden="true" inert class="grid md:grid-cols-2 gap-3 overflow-hidden" style="max-height: 0; transition: max-height 0.4s ease;">
            {upcomingMatches.map(match => {
              const isHome = match.homeAway === 'home';
              return (
                <li class={`overflow-hidden rounded-xl flex min-h-[120px] ${isHome ? 'bg-primary text-neutral' : 'bg-neutral border-2 border-primary text-primary'}`}>
                  <div class="w-1.5 flex-shrink-0" style="background-color: var(--team-color)" />
                  <div class="flex flex-col gap-2 p-5 flex-1">
                    <div class="flex items-center justify-between">
                      <div class="flex items-baseline gap-2">
                        <span class={`font-display font-bold tabular text-lg ${isHome ? 'text-neutral/80' : 'text-primary/60'}`}>{formatDate(match.date)}</span>
                        {match.time && <span class={`font-display font-bold text-base ${isHome ? 'text-neutral/60' : 'text-primary/50'}`}>{match.time} ET</span>}
                      </div>
                      <span class={`text-xs uppercase tracking-wider font-bold px-2 py-1 rounded ${isHome ? 'bg-neutral/10 text-neutral/60' : 'bg-primary/10 text-primary/50'}`}>
                        {isHome ? 'HOME' : 'AWAY'}
                      </span>
                    </div>
                    <p class="font-display font-bold text-xl leading-tight">
                      {isHome ? 'vs ' : 'at '}{match.opponent}
                    </p>
                    <div class="mt-auto flex flex-col gap-0.5">
                      <span class={`text-sm ${isHome ? 'text-neutral/70' : 'text-muted'}`}>{match.venue}</span>
                      <span class={`text-sm ${isHome ? 'text-neutral/50' : 'text-muted/70'}`}>
                        {match.broadcast.length > 0 ? match.broadcast.join(', ') : 'Broadcast TBD'}
                      </span>
                    </div>
                    {team.ticketsUrl && isHome && (
                      <a
                        href={team.ticketsUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="self-start text-xs font-bold text-neutral px-3 py-1 rounded-full hover:opacity-80 transition-opacity mt-1"
                        style="background-color: var(--team-color)"
                      >
                        Get tickets →
                      </a>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )}

    <!-- Team stats -->
    {teamStats && (
      <section class="bg-primary py-16">
        <div class="max-w-5xl mx-auto px-6">
          <h2 class="font-display font-bold text-3xl text-neutral mb-2">Team stats</h2>
          <p class="text-neutral/50 text-xs mb-6">{teamStats.games_played} games played</p>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {[
              { label: 'PPG', value: teamStats.avg_points?.toFixed(1) },
              { label: 'Opp PPG', value: teamStats.avg_points_against?.toFixed(1) },
              { label: 'RPG', value: teamStats.avg_rebounds?.toFixed(1) },
              { label: 'APG', value: teamStats.avg_assists?.toFixed(1) },
              { label: 'TPG', value: teamStats.avg_turnovers?.toFixed(1) },
              { label: 'SPG', value: teamStats.avg_steals?.toFixed(1) },
              { label: 'BPG', value: teamStats.avg_blocks?.toFixed(1) },
              { label: 'FG%', value: teamStats.field_goal_pct != null ? `${teamStats.field_goal_pct.toFixed(1)}%` : null },
              { label: '3P%', value: teamStats.three_point_pct != null ? `${teamStats.three_point_pct.toFixed(1)}%` : null },
              { label: 'FT%', value: teamStats.free_throw_pct != null ? `${teamStats.free_throw_pct.toFixed(1)}%` : null },
              { label: 'Scoring Eff.*', value: teamStats.scoring_efficiency?.toFixed(1) },
              { label: 'Shooting Eff.*', value: teamStats.shooting_efficiency?.toFixed(1) },
            ].filter(s => s.value != null).map(s => (
              <div class="bg-neutral/10 rounded-xl p-4">
                <p class="text-neutral/50 text-xs uppercase tracking-wider font-bold mb-1">{s.label}</p>
                <p class="font-display font-bold text-2xl text-neutral">{s.value}</p>
              </div>
            ))}
          </div>
          <p class="text-neutral/30 text-xs mt-4">* ESPN-defined efficiency metrics</p>
        </div>
      </section>
    )}

    <!-- Conference standings -->
    {conferenceRows.length > 0 && (
      <section class="bg-neutral py-16">
        <div class="max-w-5xl mx-auto px-6">
          <div class="flex items-center justify-between mb-6">
            <h2 class="font-display font-bold text-3xl text-primary">
              {teamConference?.replace(' Conference', '')} Conference
            </h2>
            <a href="/wnba#overall-standings" class="text-sm font-bold hover:underline" style="color: var(--team-color)">
              Overall standings →
            </a>
          </div>
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-xs uppercase tracking-wider text-muted border-b border-primary/10">
                <th class="pb-2 pr-2 font-bold w-6 text-center">#</th>
                <th class="pb-2 pr-4 font-bold">Team</th>
                <th class="pb-2 px-2 font-bold text-right">W</th>
                <th class="pb-2 px-2 font-bold text-right">L</th>
                <th class="pb-2 px-2 font-bold text-right">GB</th>
                <th class="pb-2 pl-2 font-bold text-right hidden sm:table-cell">Streak</th>
              </tr>
            </thead>
            <tbody>
              {conferenceRows.map((row, i) => {
                const rowTeam = allTeams.find(t => t.slug === row.team);
                const isCurrent = row.team === teamSlug;
                const inPlayoffs = i < 8;
                const onBubble = i === 7;
                return (
                  <tr
                    class={`border-b transition-colors ${onBubble ? 'border-b-2 border-dashed border-primary/30' : 'border-primary/5'} ${isCurrent ? 'bg-primary/[0.04]' : 'hover:bg-primary/[0.02]'}`}
                    style={rowTeam ? `border-left: 3px solid ${rowTeam.color}` : ''}
                  >
                    <td class={`py-2 pr-2 pl-1 text-center text-xs font-bold ${inPlayoffs ? 'text-primary/40' : 'text-muted/40'}`}>{row.playoff_seed}</td>
                    <td class="py-2 pr-4">
                      {isCurrent ? (
                        <div class="flex items-center gap-2 font-bold text-primary">
                          {rowTeam?.badge
                            ? <img src={rowTeam.badge} alt={rowTeam.name} width="22" height="22" class="flex-shrink-0 object-contain" />
                            : rowTeam && <span class="w-2.5 h-2.5 rounded-full flex-shrink-0 inline-block" style={`background-color: ${rowTeam.color}`} />
                          }
                          <span>{rowTeam?.name ?? row.team}</span>
                          <span class="text-xs font-bold px-1.5 py-0.5 rounded text-neutral" style="background-color: var(--team-color)">YOU</span>
                        </div>
                      ) : (
                        <a href={`/wnba/${row.team}`} class={`flex items-center gap-2 hover:underline font-medium ${inPlayoffs ? 'text-primary' : 'text-primary/50'}`}>
                          {rowTeam?.badge
                            ? <img src={rowTeam.badge} alt={rowTeam.name} width="22" height="22" class="flex-shrink-0 object-contain" />
                            : rowTeam && <span class="w-2.5 h-2.5 rounded-full flex-shrink-0 inline-block" style={`background-color: ${rowTeam.color}`} />
                          }
                          {rowTeam?.name ?? row.team}
                        </a>
                      )}
                    </td>
                    <td class={`py-2 px-2 text-right tabular-nums font-bold ${inPlayoffs ? 'text-primary' : 'text-primary/50'}`}>{row.wins}</td>
                    <td class={`py-2 px-2 text-right tabular-nums ${inPlayoffs ? 'text-primary/70' : 'text-primary/40'}`}>{row.losses}</td>
                    <td class="py-2 px-2 text-right tabular-nums text-muted">{row.games_behind === 0 ? '-' : (row.games_behind ?? '-')}</td>
                    <td class="py-2 pl-2 text-right tabular-nums text-muted hidden sm:table-cell">{row.streak ?? '-'}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <!-- Closer -->
    <section class="bg-neutral py-12">
      <div class="max-w-5xl mx-auto px-6">
        <p class="text-sm text-muted leading-relaxed max-w-2xl">
          Data sourced from <a href="https://wnba.com" target="_blank" rel="noopener noreferrer" class="font-bold hover:underline" style="color: var(--team-color)">wnba.com</a> and <a href={team.officialUrl} target="_blank" rel="noopener noreferrer" class="font-bold hover:underline" style="color: var(--team-color)">{(() => { try { return new URL(team.officialUrl).hostname.replace('www.', ''); } catch { return team.officialUrl; } })()}</a>. If you spot something wrong, email <a href="mailto:ro@standd.fan" class="font-bold hover:underline" style="color: var(--team-color)">ro@standd.fan</a>.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  const btn = document.getElementById('schedule-toggle');
  const list = document.getElementById('schedule-list') as HTMLElement | null;
  const icon = document.getElementById('schedule-toggle-icon') as HTMLElement | null;

  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    if (list) {
      list.style.maxHeight = expanded ? '0' : `${list.scrollHeight}px`;
      list.setAttribute('aria-hidden', String(expanded));
      if (expanded) { list.setAttribute('inert', ''); } else { list.removeAttribute('inert'); }
    }
    if (icon) {
      icon.style.transform = expanded ? '' : 'rotate(180deg)';
    }
  });
</script>
