---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EmailSignup from '../components/EmailSignup.astro';

const title = 'About Standd';
const description = "Standd covers women's professional sports. Built by a fan, for fans. No ads, no data sales, no paid placement.";

const promises = [
  'Free tier stays useful. Forever.',
  'No ad networks. Ever.',
  'No paid placement in rankings. Ever.',
  'No data sales. Ever.',
  'Standd+ is depth, not a gate. Cancel anytime.',
];
---

<BaseLayout title={title} description={description}>
  <Header />

  <main class="flex-1">
    <!-- Hero on cream -->
    <section class="bg-neutral pt-16 pb-12 border-b-[12px] border-accent">
      <div class="max-w-3xl mx-auto px-6">
        <p class="text-sm font-bold text-accent uppercase tracking-[0.2em] mb-4">About</p>
        <h1 class="font-display font-bold text-5xl md:text-7xl text-primary leading-[1.0] mb-8">
          Built by a fan. For fans.
        </h1>
        <div class="space-y-6 text-lg md:text-xl leading-relaxed text-primary/85">
          <p>
            Standd covers women's professional sports: NWSL, WSL, WNBA, and PWHL. Schedules, scores, standings, player pages, and <span class="font-bold text-primary">Picks</span>: a weekly cross-sport prediction game that doesn't need a friend group or a draft.
          </p>
          <p>
            It's built by one fan, on the side, for the people I'd want to talk to about a game. There's no team I won't cover. There's no paid placement, ever. There are no ads. There never will be. The free tier is genuinely useful and stays that way.
          </p>
          <p>
            <span class="font-bold text-primary">Standd+</span> is for the people who want deeper Picks history and richer wraps. Five bucks a month, forty a year, optional forever.
          </p>
          <p>
            If you grew into women's sports recently, you're who I built this for. If you've been here since the league had eight teams, <span class="font-bold text-primary">thank you</span>. You're the reason there's something here to watch. The scarves came first.
          </p>
          <p class="text-primary/60 pt-4">
            — Ro, founder<br />
            <a href="mailto:ro@standd.fan" class="text-accent font-bold hover:underline">ro@standd.fan</a>
          </p>
        </div>
      </div>
    </section>

    <!-- We Standd On Business: bold orange section with the trust commitments -->
    <section class="bg-accent py-20">
      <div class="max-w-3xl mx-auto px-6">
        <p class="text-sm font-bold text-primary uppercase tracking-[0.2em] mb-3">Trust commitments</p>
        <h2 class="font-display font-bold text-5xl md:text-7xl text-primary leading-[0.95] mb-10">
          we standd on business.
        </h2>
        <ul class="space-y-4">
          {promises.map((promise, i) => (
            <li class="flex items-baseline gap-4 text-xl md:text-2xl text-primary font-medium">
              <span class="font-display font-bold tabular text-accent bg-primary px-3 py-1 rounded text-base flex-shrink-0">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="leading-snug">{promise}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <EmailSignup />
  </main>

  <Footer />
</BaseLayout>
