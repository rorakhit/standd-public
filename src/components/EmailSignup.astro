---
const id = `email-signup-${Math.random().toString(36).slice(2, 7)}`;
---

<section class="bg-primary py-16">
  <div class="max-w-5xl mx-auto px-6">
    <p class="text-sm font-bold text-accent uppercase tracking-[0.2em] mb-3">Watch this space</p>
    <h2 class="font-display font-bold text-4xl md:text-5xl text-neutral mb-3 max-w-xl">Stay in the loop.</h2>
    <p class="text-neutral/70 text-lg mb-8 max-w-xl">Match recaps, standings, and updates as standd.fan grows. No spam, unsubscribe anytime.</p>
    <form id={id} class="flex flex-col sm:flex-row gap-3 max-w-md">
      <input
        type="email"
        name="email"
        placeholder="your@email.com"
        required
        class="flex-1 px-4 py-3 rounded-xl bg-neutral/10 border border-neutral/20 text-neutral placeholder:text-neutral/40 focus:outline-none focus:border-accent"
      />
      <button
        type="submit"
        class="px-6 py-3 bg-accent text-primary font-display font-bold rounded-xl hover:bg-neutral transition-colors whitespace-nowrap"
      >
        Subscribe
      </button>
    </form>
    <p class="mt-4 text-xs text-neutral/40">Powered by Buttondown.</p>
  </div>
</section>

<script define:vars={{ id }}>
  const form = document.getElementById(id);
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = form.querySelector('input[type="email"]').value;
    const button = form.querySelector('button[type="submit"]');

    button.disabled = true;
    button.textContent = 'Subscribing…';

    try {
      const data = new FormData();
      data.append('email', email);

      await fetch('https://buttondown.com/api/emails/embed-subscribe/Standd', {
        method: 'POST',
        body: data,
        mode: 'no-cors',
      });

      form.innerHTML = `<p class="text-accent font-display font-bold text-xl">You're in. Talk soon.</p>`;
    } catch {
      button.disabled = false;
      button.textContent = 'Subscribe';
      form.insertAdjacentHTML('afterend', '<p class="mt-3 text-sm text-red-400">Something went wrong — try again or email ro@standd.fan.</p>');
    }
  });
</script>
