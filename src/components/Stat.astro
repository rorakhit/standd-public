---
interface Props {
  label: string;
  value: string;
  highlight?: boolean;
}

const { label, value, highlight = false } = Astro.props;
---

<div class={`bg-primary p-5 flex flex-col items-center justify-center text-center min-h-[120px] ${highlight ? 'bg-accent text-primary' : 'text-neutral'}`}>
  <span class={`text-xs uppercase tracking-[0.15em] font-bold mb-2 ${highlight ? 'text-primary/70' : 'text-neutral/60'}`}>
    {label}
  </span>
  <span class={`font-display font-bold text-4xl md:text-5xl tabular leading-none ${highlight ? 'text-primary' : 'text-accent'}`}>
    {value}
  </span>
</div>
