---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Not found — Standd';
---

<BaseLayout title={title}>
  <Header />

  <main class="flex-1 max-w-3xl mx-auto px-6 py-24 text-center">
    <p class="font-display font-bold text-9xl text-accent leading-none">404</p>
    <h1 class="mt-6 font-display font-bold text-3xl md:text-4xl text-primary">This page is offside.</h1>
    <p class="mt-4 text-lg text-primary/70">
      The match you're looking for isn't on the schedule. Head
      <a href="/" class="text-accent hover:underline">home</a>
      or pick a league:
      <a href="/nwsl" class="text-accent hover:underline">NWSL</a> ·
      <a href="/wnba" class="text-accent hover:underline">WNBA</a>.
    </p>
  </main>

  <Footer />
</BaseLayout>
