---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = 'How to Watch NWSL 2026 — Free TV & Streaming Guide';
const description = 'Most NWSL matches in 2026 are free. ION (58 games, OTA), Victory+ (57, free stream), NWSL+ (28, free). Full broadcaster breakdown with match counts and pricing.';

type Broadcaster = {
  name: string;
  tag: string;
  price: string;
  matches: number;
  notes: string;
  color: string;
  isFree: boolean;
  cta?: { label: string; href: string };
};

const broadcasters: Broadcaster[] = [
  {
    name: 'ION',
    tag: 'OTA',
    price: 'Free',
    matches: 58,
    notes: 'Broadcast TV — free over the air with a TV antenna. No subscription, no login, no blackouts.',
    color: '#0033A0',
    isFree: true,
    cta: { label: 'ION channel finder', href: 'https://iontelevision.com/stations' },
  },
  {
    name: 'Victory+',
    tag: 'STREAM',
    price: 'Free',
    matches: 57,
    notes: 'Official free streaming partner of the NWSL. iOS, Android, Apple TV, Roku, Fire TV. Blackouts for nationally televised games.',
    color: '#E8003D',
    isFree: true,
    cta: { label: 'Get Victory+ free', href: 'https://victoryplus.com/hub/NWSL' },
  },
  {
    name: 'CBS Sports',
    tag: 'CABLE',
    price: 'Cable / satellite',
    matches: 36,
    notes: 'CBS Sports Network. Cable and satellite only — some matches stream at cbssports.com with a TV provider login.',
    color: '#003DA5',
    isFree: false,
  },
  {
    name: 'NWSL+',
    tag: 'STREAM',
    price: 'Free',
    matches: 28,
    notes: "The league's own app — free for US fans. Carries games not on national TV.",
    color: '#00C0A0',
    isFree: true,
    cta: { label: 'Download NWSL+', href: 'https://www.nwslsoccer.com/plus' },
  },
  {
    name: 'Amazon Prime Video',
    tag: 'PAID',
    price: 'Included with Prime',
    matches: 25,
    notes: 'Included with any Prime subscription ($14.99/mo). No sports add-on needed.',
    color: '#00A8E0',
    isFree: false,
    cta: { label: 'See Prime plans', href: 'https://www.amazon.com/amazonprime' },
  },
  {
    name: 'ESPN / ESPN2',
    tag: 'PAID',
    price: '$12.99+/mo',
    matches: 22,
    notes: '13 on ESPN, 9 on ESPN2. Stream via ESPN App with a cable login or ESPN Select subscription.',
    color: '#CC0000',
    isFree: false,
    cta: { label: 'See ESPN plans', href: 'https://plus.espn.com/' },
  },
  {
    name: 'ABC / Disney+',
    tag: 'OTA',
    price: 'Free / $11.99+/mo',
    matches: 3,
    notes: '3 marquee matches on free over-the-air ABC, simulcast on Disney+.',
    color: '#1D3B8A',
    isFree: true,
    cta: { label: 'Watch on Disney+', href: 'https://www.disneyplus.com' },
  },
];

const totalMatches = broadcasters.reduce((sum, b) => sum + b.matches, 0);
const freeMatches = broadcasters.filter(b => b.isFree).reduce((sum, b) => sum + b.matches, 0);

const steps = [
  {
    step: '01',
    title: 'Plug in an antenna.',
    body: 'ION carries 58 NWSL matches over the air. A $20 indoor antenna gets you every Saturday night.',
    cta: { label: 'ION channel finder', href: 'https://iontelevision.com/stations' },
  },
  {
    step: '02',
    title: 'Open Victory+.',
    body: 'Free streaming, no signup. iOS, Android, Apple TV, Roku, Fire TV. 57 matches in 2026.',
    cta: { label: 'Get Victory+ free', href: 'https://victoryplus.com/hub/NWSL' },
  },
  {
    step: '03',
    title: 'Get NWSL+.',
    body: "The league's own app. Carries everything not on national TV — full local coverage.",
    cta: { label: 'Download NWSL+', href: 'https://www.nwslsoccer.com/plus' },
  },
];
---

<BaseLayout title={title} description={description}>
  <Header />

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section style="background:#0F2A2D; color:#FAF6F0; padding:64px 64px 56px; position:relative; overflow:hidden;">
    <!-- Decorative background "FREE" -->
    <div aria-hidden="true" style="position:absolute; right:64px; top:50%; transform:translateY(-50%); font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:320px; line-height:0.85; letter-spacing:-0.05em; color:#FF6B2C; opacity:0.18; pointer-events:none; user-select:none; white-space:nowrap;">
      FREE
    </div>

    <div style="position:relative; max-width:760px;">
      <div class="font-mono text-[12px] font-bold tracking-[0.2em]" style="color:#FF6B2C;">HOW TO WATCH NWSL · 2026</div>
      <h1 class="font-display font-bold" style="font-size:88px; line-height:0.95; margin-top:12px; letter-spacing:-0.03em;">
        <span style="color:#FF6B2C;">{freeMatches}</span> of <span style="color:#FF6B2C;">{totalMatches}</span><br/>
        matches are free.
      </h1>
      <p style="font-size:17px; opacity:0.8; max-width:560px; margin-top:18px; line-height:1.5;">
        No cable, no add-ons, no sports tier. Plug in an antenna or open a free app — and you've got the majority of the NWSL season.
      </p>
    </div>
  </section>

  <!-- ── Signature stripe ──────────────────────────────────────────────── -->
  <div style="height:12px; background:#FF6B2C;"></div>

  <!-- ── Broadcaster grid ─────────────────────────────────────────────── -->
  <section style="background:#EDE8DE; padding:56px 64px;">
    <div class="max-w-screen-xl mx-auto">
      <h2 class="font-display font-bold text-primary" style="font-size:36px; margin-bottom:16px;">Where the matches air.</h2>
      <p style="font-size:16px; color:#5A5A5A; margin-bottom:28px;">Sorted by match volume. Tap any partner to see their coverage details.</p>

      <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:14px;" class="broadcaster-grid">
        {broadcasters.map(bc => (
          <div style="border:2px solid #0F2A2D; border-radius:14px; background:#EDE8DE; overflow:hidden;">
            <!-- Match count bar -->
            <div style="text-align:center; padding:20px 22px 16px; border-bottom:2px solid #0F2A2D;">
              <div class="font-display font-bold" style="font-size:64px; line-height:1; color:#FF6B2C; letter-spacing:-0.03em;">{bc.matches}</div>
              <div class="font-mono font-bold" style="font-size:11px; color:#5A5A5A; margin-top:4px; letter-spacing:0.12em;">MATCHES</div>
            </div>

            <!-- Info block -->
            <div style="padding:18px 22px 20px; display:grid; grid-template-columns:auto 1fr; gap:14px; align-items:center;">
              <!-- Logo tile -->
              <div style={`height:56px; border-radius:8px; background:${bc.color}; display:flex; align-items:center; justify-content:center; flex-shrink:0; padding:0 14px;`}>
                <span class="font-display font-bold" style="font-size:18px; letter-spacing:-0.02em; line-height:1; color:#FAF6F0; white-space:nowrap;">
                  {bc.name.split(' ')[0].slice(0, 6)}
                </span>
              </div>

              <div>
                <div class="flex items-center gap-2 flex-wrap" style="margin-bottom:5px;">
                  <span class="font-display font-bold text-primary" style="font-size:20px; line-height:1.1;">{bc.name}</span>
                  <span class="font-mono font-bold" style={`font-size:10px; letter-spacing:0.1em; padding:3px 8px; border-radius:4px; ${bc.isFree ? 'background:#FF6B2C; color:#0F2A2D;' : 'background:#0F2A2D; color:#FF6B2C;'}`}>
                    {bc.tag}
                  </span>
                </div>
                <div class="font-mono font-bold" style="font-size:12px; color:#0F2A2D; margin-bottom:6px;">{bc.price}</div>
                <p style="font-size:13px; color:#5A5A5A; line-height:1.45;">{bc.notes}</p>
                {bc.cta && (
                  <a href={bc.cta.href} target="_blank" rel="noopener noreferrer"
                    class="font-mono font-bold hover:opacity-75 transition-opacity"
                    style="font-size:11px; color:#FF6B2C; text-decoration:none; display:inline-block; border-bottom:1.5px solid #FF6B2C; margin-top:10px;">
                    {bc.cta.label} →
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Three paths to free ───────────────────────────────────────────── -->
  <section style="background:#0F2A2D; color:#FAF6F0; padding:56px 64px;">
    <div class="max-w-screen-xl mx-auto">
      <h2 class="font-display font-bold" style="font-size:36px; margin-bottom:24px;">Three paths to free NWSL.</h2>
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:24px;" class="paths-grid">
        {steps.map(s => (
          <div style="border-top:4px solid #FF6B2C; padding-top:16px;">
            <div class="font-mono font-bold" style="font-size:12px; letter-spacing:0.15em; color:#FF6B2C;">STEP {s.step}</div>
            <h3 class="font-display font-bold" style="font-size:28px; color:#FAF6F0; margin-top:10px; line-height:1.1;">{s.title}</h3>
            <p style="font-size:14px; line-height:1.55; color:rgba(250,246,240,0.75); margin-top:8px;">{s.body}</p>
            <a href={s.cta.href} target="_blank" rel="noopener noreferrer"
              class="font-mono font-bold hover:opacity-75 transition-opacity"
              style="display:inline-flex; align-items:center; font-size:12px; color:#FF6B2C; text-decoration:none; border-bottom:1.5px solid #FF6B2C; margin-top:14px;">
              {s.cta.label} →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  @media (max-width: 900px) {
    .broadcaster-grid { grid-template-columns: 1fr !important; }
    .paths-grid { grid-template-columns: 1fr !important; }
  }
  @media (max-width: 600px) {
    section { padding-left: 24px !important; padding-right: 24px !important; }
  }
</style>
