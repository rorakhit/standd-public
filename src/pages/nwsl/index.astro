---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { nwslStandings, standingsLastUpdated } from '../../data/leagues/nwsl/standings';

const PLAYOFF_LINE = 8;

const title = 'NWSL 2026 — Standd';
const description = 'NWSL 2026 season — standings, team trackers, and more. Covering Boston Legacy and beyond.';
---

<BaseLayout title={title} description={description}>
  <Header />

  <main class="flex-1">
    <section class="bg-neutral pt-12 pb-12 border-b-[12px] border-accent">
      <div class="max-w-3xl mx-auto px-6">
        <p class="text-sm font-bold text-accent uppercase tracking-[0.2em] mb-3">2026 Season</p>
        <h1 class="font-display font-bold text-5xl md:text-7xl text-primary leading-[1.0] mb-6">
          NWSL
        </h1>
        <p class="text-lg text-primary/80 leading-relaxed">
          The National Women's Soccer League. 16 teams, one season. Follow the standings and dive into Boston Legacy's inaugural year.
        </p>
      </div>
    </section>

    <!-- Team trackers -->
    <section class="bg-primary py-16">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="font-display font-bold text-3xl text-accent mb-8 uppercase tracking-wider">Team trackers</h2>
        <a
          href="/nwsl/boston-legacy"
          class="flex items-center justify-between bg-neutral/10 hover:bg-neutral/20 transition-colors rounded-2xl p-6 group"
        >
          <div>
            <p class="text-xs text-neutral/50 uppercase tracking-wider font-bold mb-1">Inaugural Season</p>
            <p class="font-display font-bold text-2xl text-neutral leading-tight">Boston Legacy</p>
            <p class="text-sm text-neutral/60 mt-1">Results · Fixtures · Roster · How to Watch</p>
          </div>
          <span class="text-accent text-2xl group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </section>

    <!-- Standings -->
    <section class="bg-neutral py-16">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="font-display font-bold text-3xl text-primary mb-2">Standings</h2>
        <p class="text-muted text-sm mb-6">Top 8 teams qualify for playoffs. Updated {standingsLastUpdated}.</p>
        <div class="overflow-x-auto bg-neutral border-2 border-primary rounded-2xl">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-primary text-neutral text-left">
                <th class="px-4 py-3 font-bold tabular w-12">#</th>
                <th class="px-4 py-3 font-bold">Team</th>
                <th class="px-3 py-3 font-bold tabular text-right">P</th>
                <th class="px-3 py-3 font-bold tabular text-right">W</th>
                <th class="px-3 py-3 font-bold tabular text-right">D</th>
                <th class="px-3 py-3 font-bold tabular text-right">L</th>
                <th class="px-3 py-3 font-bold tabular text-right">GD</th>
                <th class="px-4 py-3 font-bold tabular text-right">PTS</th>
              </tr>
            </thead>
            <tbody>
              {nwslStandings.map((row, i) => {
                const pos = i + 1;
                const isBoston = row.team === 'Boston Legacy';
                const isPlayoff = pos <= PLAYOFF_LINE;
                const gd = row.goalsFor - row.goalsAgainst;
                const isPlayoffCutoff = pos === PLAYOFF_LINE;
                return (
                  <>
                    <tr class={`border-b border-primary/10 ${isBoston ? 'bg-accent/15 font-bold' : isPlayoff ? 'bg-primary/[0.03]' : ''}`}>
                      <td class="px-4 py-3 tabular">
                        <span class={`inline-flex items-center justify-center w-7 h-7 rounded-full font-bold text-xs ${isPlayoff ? 'bg-accent text-primary' : 'bg-muted/15 text-muted'}`}>
                          {pos}
                        </span>
                      </td>
                      <td class="px-4 py-3 text-primary">
                        {isBoston
                          ? <a href="/nwsl/boston-legacy" class="hover:text-accent transition-colors">{row.team}</a>
                          : row.team
                        }
                      </td>
                      <td class="px-3 py-3 tabular text-right">{row.played}</td>
                      <td class="px-3 py-3 tabular text-right">{row.wins}</td>
                      <td class="px-3 py-3 tabular text-right">{row.draws}</td>
                      <td class="px-3 py-3 tabular text-right">{row.losses}</td>
                      <td class="px-3 py-3 tabular text-right text-muted">{gd > 0 ? '+' : ''}{gd}</td>
                      <td class="px-4 py-3 tabular text-right font-bold text-primary">{row.points}</td>
                    </tr>
                    {isPlayoffCutoff && (
                      <tr aria-hidden="true">
                        <td colspan="8" class="bg-accent text-primary text-xs font-bold uppercase tracking-[0.2em] px-4 py-2 text-center">
                          ↑ Playoff line · ↓ Outside the playoffs
                        </td>
                      </tr>
                    )}
                  </>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
