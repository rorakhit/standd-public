---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import TeamTrackerSubNav from '../../../components/TeamTrackerSubNav.astro';
import Footer from '../../../components/Footer.astro';
import { team as atlantaDream } from '../../../data/teams/wnba/atlanta-dream';
import { team as chicagoSky } from '../../../data/teams/wnba/chicago-sky';
import { team as connecticutSun } from '../../../data/teams/wnba/connecticut-sun';
import { team as dallasWings } from '../../../data/teams/wnba/dallas-wings';
import { team as goldenStateValkyries } from '../../../data/teams/wnba/golden-state-valkyries';
import { team as indianaFever } from '../../../data/teams/wnba/indiana-fever';
import { team as lasVegasAces } from '../../../data/teams/wnba/las-vegas-aces';
import { team as losAngelesSparks } from '../../../data/teams/wnba/los-angeles-sparks';
import { team as minnesotaLynx } from '../../../data/teams/wnba/minnesota-lynx';
import { team as newYorkLiberty } from '../../../data/teams/wnba/new-york-liberty';
import { team as phoenixMercury } from '../../../data/teams/wnba/phoenix-mercury';
import { team as seattleStorm } from '../../../data/teams/wnba/seattle-storm';
import { team as washingtonMystics } from '../../../data/teams/wnba/washington-mystics';
import { team as portlandFire } from '../../../data/teams/wnba/portland-fire';
import { team as torontoTempo } from '../../../data/teams/wnba/toronto-tempo';
import type { WNBATeamConfig } from '../../../data/shared/types';
import { getTeamRoster, getPlayerStats, getStandings } from '../../../data/wnba/queries';

const allTeams: WNBATeamConfig[] = [
  atlantaDream, chicagoSky, connecticutSun, dallasWings,
  goldenStateValkyries, indianaFever, lasVegasAces, losAngelesSparks,
  minnesotaLynx, newYorkLiberty, phoenixMercury, portlandFire,
  seattleStorm, torontoTempo, washingtonMystics,
];

export function getStaticPaths() {
  return [
    'atlanta-dream', 'chicago-sky', 'connecticut-sun', 'dallas-wings',
    'golden-state-valkyries', 'indiana-fever', 'las-vegas-aces', 'los-angeles-sparks',
    'minnesota-lynx', 'new-york-liberty', 'phoenix-mercury', 'portland-fire',
    'seattle-storm', 'toronto-tempo', 'washington-mystics',
  ].map(slug => ({ params: { team: slug } }));
}

const { team: teamSlug } = Astro.params;
const team = allTeams.find(t => t.slug === teamSlug)!;

// Set SEASON_LIVE=true in .env once the regular season begins.
// When false, the current year's stats are hidden (preseason data only).
const SEASON_LIVE = import.meta.env.SEASON_LIVE === 'true';
const currentYear = new Date().getFullYear();

const [roster, standings] = await Promise.all([
  getTeamRoster(teamSlug),
  getStandings(),
]);
const teamStanding = standings.find(s => s.team === team.standingsKey) ?? null;
const espnIds = roster.map(p => p.espn_id);
const allStats = await getPlayerStats(espnIds);

type StatLine = {
  gp: number|null; mpg: number|null; ppg: number|null; rpg: number|null;
  apg: number|null; spg: number|null; bpg: number|null; tov: number|null;
  fgp: number|null; tpp: number|null; ftp: number|null;
};
function toStatLine(s: typeof allStats[0] | undefined): StatLine {
  return {
    gp:  s?.games_played      ?? null,
    mpg: s?.avg_minutes       ?? null,
    ppg: s?.avg_points        ?? null,
    rpg: s?.avg_rebounds      ?? null,
    apg: s?.avg_assists       ?? null,
    spg: s?.avg_steals        ?? null,
    bpg: s?.avg_blocks        ?? null,
    tov: s?.avg_turnovers     ?? null,
    fgp: s?.field_goal_pct    ?? null,
    tpp: s?.three_point_pct   ?? null,
    ftp: s?.free_throw_pct    ?? null,
  };
}

// Group stats by player: all non-career rows become seasons[], sorted newest first
const statsMap = new Map<string, { seasons: { year: number|null; stats: StatLine }[]; career: StatLine }>();
for (const s of allStats) {
  const entry = statsMap.get(s.espn_id) ?? { seasons: [], career: toStatLine(undefined) };
  if (s.split === 'career') {
    entry.career = toStatLine(s);
  } else {
    const year = s.season ?? (s.split === 'regular_season' ? currentYear : parseInt(s.split) || null);
    // Suppress current-year stats until SEASON_LIVE=true (avoids showing preseason data)
    if (!SEASON_LIVE && year === currentYear) { statsMap.set(s.espn_id, entry); continue; }
    entry.seasons.push({ year, stats: toStatLine(s) });
  }
  statsMap.set(s.espn_id, entry);
}
for (const entry of statsMap.values()) {
  entry.seasons.sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
}

// Build player objects with stats for client-side serialization
type PlayerData = {
  espn_id: string; slug: string; num: string | null; name: string;
  pos: string; posLong: string; ht: string; college: string; photo: string;
  rookie: boolean;
  season: StatLine;  // most recent season (for cards + modal hero)
  career: StatLine;
  seasons: { year: number|null; stats: StatLine }[]; // all seasons desc for splits tab
};
const players: PlayerData[] = roster.map(p => {
  const entry = statsMap.get(p.espn_id) ?? { seasons: [], career: toStatLine(undefined) };
  return {
    espn_id: p.espn_id,
    slug: p.espn_id,
    num: p.jersey ?? '',
    name: p.full_name,
    pos: p.position ?? '—',
    posLong: p.position === 'G' ? 'Guard' : p.position === 'F' ? 'Forward' : p.position === 'C' ? 'Center' : '—',
    ht: p.height ?? '—',
    college: p.college ?? '—',
    photo: `https://a.espncdn.com/i/headshots/wnba/players/full/${p.espn_id}.png`,
    rookie: p.rookie === 1,
    season: entry.seasons[0]?.stats ?? toStatLine(undefined),
    career: entry.career,
    seasons: entry.seasons,
  };
});

// Compute stat leaders from players who have season stats
function statLeader(ps: PlayerData[], getter: (p: PlayerData) => number | null) {
  let best: PlayerData | null = null;
  let bestVal = -Infinity;
  for (const p of ps) {
    const v = getter(p);
    if (v != null && v > bestVal) { bestVal = v; best = p; }
  }
  return best ? { player: best, value: bestVal } : null;
}

const statTips: Record<string, string> = {
  PPG: 'Points Per Game — average points scored each game',
  RPG: 'Rebounds Per Game — average boards grabbed each game',
  APG: 'Assists Per Game — average passes leading to a score each game',
  BPG: 'Blocks Per Game — average shots blocked each game',
  SPG: 'Steals Per Game — average turnovers forced each game',
};

const leaders = [
  { stat: 'PPG', result: statLeader(players, p => p.season.ppg) },
  { stat: 'RPG', result: statLeader(players, p => p.season.rpg) },
  { stat: 'APG', result: statLeader(players, p => p.season.apg) },
  { stat: 'BPG', result: statLeader(players, p => p.season.bpg) },
  { stat: 'SPG', result: statLeader(players, p => p.season.spg) },
].filter(l => l.result !== null);

const teamColor = team.color ?? '#0F2A2D';
// Last word of team name as mascot label in the mark band
const teamMascot = team.name.split(/\s+/).pop() ?? '';
// Short abbreviation — first letter of each word, max 2 chars
const teamShort = team.name.split(/\s+/).map(w => w[0]).join('').slice(0, 2).toUpperCase();

function fmt(v: number | null, dec = 1): string {
  return v == null ? '—' : v.toFixed(dec);
}
function fmtPct(v: number | null): string {
  if (v == null) return '—';
  // ESPN API returns raw decimal (0.0–1.0) for percentages
  const pct = v > 1 ? v : v * 100;
  return pct.toFixed(1);
}

const playersJson = JSON.stringify(players);
const title = `${team.name} 2026 Roster — WNBA player stats`;
const description = `Full ${team.name} 2026 WNBA roster with per-player stats — points, rebounds, assists, and shooting splits.`;
---

<BaseLayout title={title} description={description}>
  <style is:global>
    /* hero-glow var set per-team via inline style on .hero-band */
    .hero-band { --hero-glow: var(--color-accent); }
    /* carry team color into page body background */
    .roster-body-wrap {
      background: linear-gradient(
        to bottom,
        color-mix(in oklab, var(--team-color) 25%, transparent) 0px,
        transparent 640px
      );
    }
  </style>
  <Header />
  <TeamTrackerSubNav leagueSlug="wnba" teamSlug={team.slug} showHowToWatch showPlayers />

  <style>
    /* ---- Page ---- */
    .roster-page { max-width: 1200px; margin: 0 auto; padding: 32px 24px 80px; }

    /* ---- Dark hero band (full-bleed) ---- */
    .hero-band {
      background: var(--hero-glow);
      color: var(--color-neutral);
      position: relative; overflow: hidden;
      padding: 40px 0 0;
      margin-bottom: 0;
    }
    .hero-band::before {
      content: '';
      position: absolute; right: -100px; top: -120px;
      width: 680px; height: 680px; border-radius: 50%;
      background: radial-gradient(circle,
        color-mix(in oklab, var(--hero-glow) 90%, white) 0%,
        color-mix(in oklab, var(--hero-glow) 55%, white) 25%,
        color-mix(in oklab, var(--hero-glow) 20%, transparent) 55%,
        transparent 72%);
      pointer-events: none; mix-blend-mode: screen; opacity: 0.65;
    }
    .hero-inner {
      max-width: 1200px; margin: 0 auto;
      padding: 0 24px; position: relative; z-index: 1;
    }
    .hero-top { display: flex; align-items: flex-start; gap: 24px; margin-bottom: 28px; }
    .team-mark {
      width: clamp(96px, 11vw, 140px); height: clamp(96px, 11vw, 140px);
      border-radius: 20px;
      display: grid; place-items: center;
      position: relative; overflow: hidden;
      flex-shrink: 0;
    }
    .team-mark-img {
      width: clamp(96px, 11vw, 140px); height: clamp(96px, 11vw, 140px);
      object-fit: contain; flex-shrink: 0;
      filter: drop-shadow(0 2px 12px rgba(0,0,0,0.5));
    }
    .team-mark-letters {
      font-family: var(--font-display); font-weight: 700;
      font-size: 38px; line-height: 0.85;
      letter-spacing: -0.04em; color: #fff;
      position: relative; z-index: 1;
    }
    .team-mark-band {
      position: absolute; bottom: 0; left: 0; right: 0;
      height: 26px; display: grid; place-items: center;
    }
    .team-mark-band span {
      font-family: var(--font-display); font-weight: 700;
      font-size: 9px; color: #fff;
      letter-spacing: 0.18em; text-transform: uppercase;
    }
    .hero-id { flex: 1; min-width: 0; }
    .hero-eyebrow {
      font-size: 13px; font-weight: 500; letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(250,246,240,0.55);
      font-family: var(--font-display);
      margin: 0 0 6px;
    }
    .hero-name {
      font-family: var(--font-display); font-weight: 700;
      font-size: clamp(48px, 7vw, 80px);
      line-height: 0.88; letter-spacing: -0.04em;
      color: #fff; margin: 0 0 14px;
    }
    .hero-meta {
      display: flex; gap: 20px; flex-wrap: wrap;
      font-family: var(--font-mono); font-size: 13px;
      color: rgba(250,246,240,0.65);
    }
    .hero-meta strong { color: #fff; font-weight: 600; }

    /* Score band */
    .scoreband {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      border-top: 1px solid rgba(250,246,240,0.10);
      margin-top: 28px;
    }
    .scoreband-cell {
      padding: 20px 20px 22px;
      border-right: 1px solid rgba(250,246,240,0.10);
    }
    .scoreband-cell:last-child { border-right: none; }
    .scoreband-lbl {
      font-size: 9px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.2em;
      color: rgba(250,246,240,0.45); margin-bottom: 6px;
    }
    .scoreband-val {
      font-family: var(--font-mono); font-weight: 600;
      font-size: 28px; line-height: 1; letter-spacing: -0.03em;
      color: #fff; font-variant-numeric: tabular-nums;
    }
    .scoreband-sub {
      font-family: var(--font-mono); font-size: 11px;
      color: rgba(250,246,240,0.45); margin-top: 4px;
    }

    /* ---- Leaders strip ---- */
    .leaders {
      background: color-mix(in oklab, var(--hero-glow) 85%, #000);
      border-radius: 16px;
      overflow: visible;
      margin-bottom: 32px;
    }
    .leaders-inner {
      border-radius: 16px;
      overflow: hidden;
    }
    .leaders-label {
      padding: 16px 20px 0;
      font-size: 13px; font-weight: 800;
      text-transform: uppercase; letter-spacing: 0.15em;
      color: rgba(250,246,240,0.9);
    }
    .leaders-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    }
    .leader-cell {
      padding: 14px 18px 18px;
      border-right: 1px solid rgba(250,246,240,0.08);
      border-radius: 12px;
      cursor: pointer;
      transition: background-color 150ms, transform 150ms, box-shadow 150ms;
    }
    .leader-cell:last-child { border-right: none; }
    .leader-cell:hover {
      background: rgba(250,246,240,0.15);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(0,0,0,0.25);
    }
    .leader-stat-label {
      font-size: 11px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.15em;
      margin-bottom: 6px;
    }
    .leader-value {
      font-family: var(--font-mono); font-weight: 600;
      font-size: 34px; line-height: 1;
      letter-spacing: -0.03em;
      font-variant-numeric: tabular-nums;
      color: #fff; margin-bottom: 10px;
    }
    .leader-name {
      font-family: var(--font-display); font-weight: 700;
      font-size: 14px; line-height: 1.1; color: #fff;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .leader-meta {
      font-family: var(--font-mono); font-size: 12px;
      color: rgba(250,246,240,0.85); margin-top: 2px;
    }

    /* ---- Toolbar ---- */
    .toolbar {
      display: flex; flex-wrap: wrap; gap: 12px;
      align-items: center; justify-content: space-between;
      margin-bottom: 20px;
    }
    .toolbar-left, .toolbar-right { display: flex; gap: 8px; align-items: center; }

    .pill-group { display: flex; gap: 4px; }
    .pill {
      padding: 6px 14px;
      border-radius: 9999px;
      font-size: 12px; font-weight: 700;
      cursor: pointer; border: 1.5px solid rgba(15,42,45,0.15);
      background: transparent; color: var(--color-muted);
      transition: all 120ms;
    }
    .pill.active {
      background: var(--color-primary);
      color: var(--color-neutral);
      border-color: var(--color-primary);
    }

    .view-toggle { display: flex; gap: 0; border: 1.5px solid rgba(15,42,45,0.15); border-radius: 8px; overflow: hidden; }
    .view-btn {
      padding: 6px 12px; background: transparent; border: none;
      font-size: 13px; cursor: pointer; color: var(--color-muted);
      transition: background-color 120ms;
    }
    .view-btn.active { background: var(--color-primary); color: #fff; }

    .search-input {
      padding: 6px 12px; border-radius: 8px;
      border: 1.5px solid rgba(15,42,45,0.15);
      font-family: var(--font-body); font-size: 13px;
      color: var(--color-primary); background: transparent;
      width: 180px; outline: none;
    }
    .search-input:focus { border-color: var(--color-primary); }
    .search-input::placeholder { color: var(--color-muted); }

    /* ---- Cards grid ---- */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 12px;
    }
    .roster-card {
      background: var(--color-neutral);
      border: 2px solid rgba(15,42,45,0.10);
      border-radius: 16px; overflow: hidden;
      cursor: pointer; display: flex; flex-direction: column;
      transition: border-color 200ms var(--ease-standard), transform 200ms var(--ease-standard);
    }
    .roster-card:hover { transform: translateY(-2px); }
    .card-top {
      display: flex; gap: 12px; padding: 14px;
      align-items: center;
      border-bottom: 1px solid rgba(15,42,45,0.08);
    }
    .card-avatar {
      width: 48px; height: 48px; border-radius: 50%;
      object-fit: cover; object-position: top;
      flex-shrink: 0;
    }
    .card-avatar-fallback {
      width: 48px; height: 48px; border-radius: 50%;
      display: grid; place-items: center;
      font-family: var(--font-display); font-weight: 700;
      font-size: 16px; flex-shrink: 0;
    }
    .card-num {
      font-family: var(--font-mono); font-weight: 600;
      font-size: 17px; line-height: 1; letter-spacing: -0.02em;
    }
    .card-name {
      font-family: var(--font-display); font-weight: 700;
      font-size: 15px; color: var(--color-primary);
      letter-spacing: -0.01em;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      flex: 1; min-width: 0;
    }
    .card-meta {
      font-family: var(--font-mono); font-size: 11px;
      color: var(--color-muted); margin-top: 3px;
      display: flex; gap: 6px; align-items: center; flex-wrap: wrap;
    }
    .card-stats {
      display: grid; grid-template-columns: repeat(5, 1fr);
      background: rgba(15,42,45,0.03);
    }
    .card-stat-cell {
      padding: 10px 0; text-align: center;
      border-right: 1px solid rgba(15,42,45,0.08);
    }
    .card-stat-cell:last-child { border-right: none; }
    .card-stat-val {
      font-family: var(--font-mono); font-weight: 600;
      font-size: 15px; color: var(--color-primary);
      font-variant-numeric: tabular-nums; line-height: 1;
    }
    .card-stat-lbl {
      font-size: 9px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.14em;
      color: var(--color-muted); margin-top: 4px;
    }

    /* ---- Table view ---- */
    .table-wrap {
      border: 2px solid var(--color-primary);
      border-radius: 16px; overflow: hidden;
    }
    .roster-table {
      width: 100%; border-collapse: separate;
      border-spacing: 0; min-width: 900px;
    }
    .roster-table thead tr { background: var(--color-primary); }
    .roster-table th {
      padding: 12px 8px;
      font-size: 9px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.16em;
      color: rgba(250,246,240,0.7);
      cursor: pointer; user-select: none;
      white-space: nowrap;
    }
    .roster-table th.active { color: #fff; }
    .roster-table th.left { text-align: left; }
    .roster-table th.right { text-align: right; }
    .roster-table th.center { text-align: center; }
    .roster-table td {
      padding: 10px 8px;
      border-top: 1px solid rgba(15,42,45,0.06);
      white-space: nowrap;
    }
    .roster-table tr { cursor: pointer; transition: background-color 120ms; }
    .td-name { display: flex; align-items: center; gap: 10px; }
    .td-avatar {
      width: 36px; height: 36px; border-radius: 50%;
      object-fit: cover; object-position: top; flex-shrink: 0;
    }
    .td-avatar-fallback {
      width: 36px; height: 36px; border-radius: 50%;
      display: grid; place-items: center;
      font-family: var(--font-display); font-weight: 700;
      font-size: 12px; flex-shrink: 0;
    }
    .td-pname {
      font-family: var(--font-display); font-weight: 700;
      font-size: 13px; color: var(--color-primary);
      letter-spacing: -0.01em;
    }
    .td-pmeta {
      font-family: var(--font-mono); font-size: 10px;
      color: var(--color-muted); margin-top: 1px;
    }
    .td-num { font-family: var(--font-mono); font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; }
    .td-stat { font-family: var(--font-mono); font-size: 13px; font-weight: 500; font-variant-numeric: tabular-nums; text-align: right; color: var(--color-primary); }
    .td-stat-bold { font-weight: 700; font-size: 14px; }
    .td-pos { font-family: var(--font-display); font-size: 12px; font-weight: 700; text-align: center; }
    .sort-arrow { margin-left: 3px; font-size: 8px; }

    /* ---- Split toggle ---- */
    .split-toggle { display: flex; gap: 4px; }

    /* ---- Empty state ---- */
    .empty {
      padding: 64px 24px; text-align: center;
      border: 2px solid rgba(15,42,45,0.10);
      border-radius: 16px;
    }
    .empty h2 { font-family: var(--font-display); font-size: 24px; margin: 0 0 8px; }
    .empty p { color: var(--color-muted); margin: 0; }

    /* ---- Modal ---- */
    .modal-overlay {
      position: fixed; inset: 0; z-index: 200;
      background: rgba(15,42,45,0.55);
      backdrop-filter: blur(2px);
      display: grid; place-items: start center;
      padding: 32px 16px;
      overflow-y: auto;
      opacity: 0; pointer-events: none;
      transition: opacity 180ms ease-out;
    }
    .modal-overlay.open { opacity: 1; pointer-events: all; }
    .modal-box {
      width: min(1080px, 100%);
      background: var(--color-neutral);
      border-radius: 20px; overflow: hidden;
      box-shadow: 0 30px 80px rgba(15,42,45,0.40);
      transform: translateY(12px) scale(0.985);
      transition: transform 180ms ease-out;
    }
    .modal-overlay.open .modal-box { transform: none; }
    .modal-header { padding: 24px 28px 0; position: relative; }
    .modal-controls {
      position: absolute; top: 16px; right: 16px;
      display: flex; gap: 6px; z-index: 2;
    }
    .modal-ctrl-btn {
      width: 36px; height: 36px; border-radius: 9999px;
      border: 1px solid rgba(255,255,255,0.30);
      background: rgba(0,0,0,0.18); color: #fff;
      font-weight: 700; font-size: 16px;
      cursor: pointer; display: grid; place-items: center;
      transition: background-color 150ms;
    }
    .modal-ctrl-btn:hover { background: rgba(0,0,0,0.35); }
    .modal-eyebrow {
      font-size: 11px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.2em;
      color: rgba(255,255,255,0.65);
      margin: 0 0 12px;
    }
    .modal-identity { display: grid; grid-template-columns: auto 1fr; gap: 24px; align-items: end; }
    .modal-player-avatar {
      width: 120px; height: 120px; border-radius: 50%;
      object-fit: cover; object-position: top;
    }
    .modal-player-avatar-fallback {
      width: 120px; height: 120px; border-radius: 50%;
      display: grid; place-items: center;
      font-family: var(--font-display); font-weight: 700;
      font-size: 40px; color: rgba(255,255,255,0.75);
    }
    .modal-name {
      font-family: var(--font-display); font-weight: 700;
      font-size: clamp(32px, 6vw, 56px);
      line-height: 0.92; letter-spacing: -0.04em;
      color: #fff; margin: 0 0 12px;
    }
    .modal-attrs {
      display: flex; flex-wrap: wrap; gap: 8px 14px;
      font-family: var(--font-mono); font-size: 12px;
      color: rgba(255,255,255,0.75);
    }
    .modal-attrs span { display: flex; align-items: center; gap: 4px; }
    .modal-hero-stats {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      margin: 20px -28px 0;
      background: rgba(0,0,0,0.20);
      border-top: 1px solid rgba(255,255,255,0.10);
    }
    .modal-stat-cell {
      padding: 18px 20px;
      border-right: 1px solid rgba(255,255,255,0.10);
    }
    .modal-stat-cell:last-child { border-right: none; }
    .modal-stat-val {
      font-family: var(--font-mono); font-weight: 600;
      font-size: 36px; line-height: 1; letter-spacing: -0.04em;
      color: #fff; font-variant-numeric: tabular-nums;
    }
    .modal-stat-lbl {
      font-size: 9px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.18em;
      color: rgba(255,255,255,0.65); margin-top: 6px;
    }
    .modal-body { padding: 24px 28px 32px; }
    .modal-tab-bar {
      display: flex; gap: 0;
      border-bottom: 1px solid rgba(15,42,45,0.10);
      margin-bottom: 24px;
    }
    .modal-tab {
      background: transparent; border: 0;
      padding: 10px 16px; cursor: pointer;
      font-family: var(--font-body); font-size: 13px; font-weight: 500;
      color: rgba(15,42,45,0.45);
      border-bottom: 2px solid transparent;
      margin-bottom: -1px;
      transition: color 120ms;
    }
    .modal-tab.active { font-weight: 700; color: var(--color-primary); }
    .tab-pane { display: none; }
    .tab-pane.active { display: block; }

    /* Per game / stat tiles */
    .stat-tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .stat-tile {
      background: rgba(15,42,45,0.04);
      padding: 14px 16px; border-radius: 12px;
      display: flex; flex-direction: column; gap: 4px;
    }
    .stat-tile.accent { background: var(--color-primary); }
    .stat-tile-lbl { font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.18em; opacity: 0.6; }
    .stat-tile-val { font-family: var(--font-mono); font-weight: 600; font-size: 24px; line-height: 1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
    .stat-tile-sub { font-family: var(--font-mono); font-size: 11px; opacity: 0.55; }
    .stat-tile.accent .stat-tile-lbl, .stat-tile.accent .stat-tile-val, .stat-tile.accent .stat-tile-sub { color: #fff; }

    /* Splits table */
    .splits-table { width: 100%; border-collapse: separate; border-spacing: 0; border: 1px solid rgba(15,42,45,0.10); border-radius: 12px; overflow: hidden; }
    .splits-table th { padding: 10px 12px; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; color: var(--color-muted); background: rgba(15,42,45,0.04); }
    .splits-table td { padding: 12px; border-top: 1px solid rgba(15,42,45,0.08); font-family: var(--font-mono); font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; }

    /* Rookie badge */
    .rookie-badge {
      display: inline-block;
      padding: 1px 6px;
      border-radius: 4px;
      background: var(--color-accent);
      color: var(--color-primary);
      font-size: 9px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.1em;
      line-height: 1.6;
      vertical-align: middle;
    }

    /* Responsive */
    @media (max-width: 640px) {
      .hero { grid-template-columns: 1fr; gap: 16px; }
      .modal-identity { grid-template-columns: 1fr; }
      .modal-player-avatar, .modal-player-avatar-fallback { width: 80px; height: 80px; }
      .modal-hero-stats { grid-template-columns: repeat(3, 1fr); }
      .stat-tiles { grid-template-columns: repeat(2, 1fr); }
      .leaders-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 400px) {
      .modal-hero-stats { grid-template-columns: repeat(2, 1fr); }
    }
  </style>

  <!-- Dark hero band (full-bleed, outside max-width container) -->
  <div class="hero-band" style={`--hero-glow: ${teamColor};`}>
    <div class="hero-inner">
      <div class="hero-top">
        <!-- Team mark -->
        {team.badge ? (
          <img src={team.badge} alt={team.name} width="140" height="140"
            class="team-mark-img" />
        ) : (
          <div class="team-mark" style={`background: ${teamColor};`}>
            <span class="team-mark-letters">{teamShort}</span>
            <div class="team-mark-band" style="background:rgba(0,0,0,0.35);">
              <span>{teamMascot.toUpperCase()}</span>
            </div>
          </div>
        )}
        <!-- Identity -->
        <div class="hero-id">
          <p class="hero-eyebrow">WNBA · 2026 Season</p>
          <h1 class="hero-name">{team.name} Roster</h1>
          <div class="hero-meta">
            <span><strong>{roster.length}</strong> players</span>
            {roster.filter(p => p.rookie === 1).length > 0 && (
              <span><strong>{roster.filter(p => p.rookie === 1).length}</strong> rookies</span>
            )}
          </div>
        </div>
      </div>

      <!-- Score band from standings -->
      {teamStanding && (
        <div class="scoreband">
          <div class="scoreband-cell">
            <div class="scoreband-lbl">Record</div>
            <div class="scoreband-val" style={`color:${teamColor === '#0F2A2D' ? '#fff' : teamColor};`}>
              {teamStanding.wins}–{teamStanding.losses}
            </div>
            <div class="scoreband-sub">{(teamStanding.win_pct * 100).toFixed(1)}% · seed #{teamStanding.playoff_seed ?? '—'}</div>
          </div>
          {teamStanding.home_record && (
            <div class="scoreband-cell">
              <div class="scoreband-lbl">Home</div>
              <div class="scoreband-val">{teamStanding.home_record}</div>
              <div class="scoreband-sub">away {teamStanding.away_record ?? '—'}</div>
            </div>
          )}
          {teamStanding.streak && (
            <div class="scoreband-cell">
              <div class="scoreband-lbl">Streak</div>
              <div class="scoreband-val" style={teamStanding.streak.startsWith('W') ? `color:${teamColor};` : 'color:rgba(250,246,240,0.6);'}>
                {teamStanding.streak}
              </div>
              {teamStanding.last_10 && <div class="scoreband-sub">L10: {teamStanding.last_10}</div>}
            </div>
          )}
          {teamStanding.conference_record && (
            <div class="scoreband-cell">
              <div class="scoreband-lbl">Conf.</div>
              <div class="scoreband-val">{teamStanding.conference_record}</div>
              <div class="scoreband-sub">{teamStanding.conference}</div>
