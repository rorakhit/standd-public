---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import TeamTrackerSubNav from '../../../components/TeamTrackerSubNav.astro';
import Footer from '../../../components/Footer.astro';
import Stat from '../../../components/Stat.astro';
import Broadcaster from '../../../components/Broadcaster.astro';
import EmailSignup from '../../../components/EmailSignup.astro';
import { matches, team } from '../../../data/teams/nwsl/washington-spirit';
import { nwslStandings, standingsLastUpdated, standingsDisplayName } from '../../../data/leagues/nwsl/standings';
import { team as bostonLegacy } from '../../../data/teams/nwsl/boston-legacy';
import { team as portlandThorns } from '../../../data/teams/nwsl/portland-thorns';
import { team as sanDiegoWave } from '../../../data/teams/nwsl/san-diego-wave';
import { team as washingtonSpirit } from '../../../data/teams/nwsl/washington-spirit';
import { team as gothamFc } from '../../../data/teams/nwsl/gotham-fc';
import { team as seattleReign } from '../../../data/teams/nwsl/seattle-reign';
import { team as houstonDash } from '../../../data/teams/nwsl/houston-dash';
import { team as utahRoyals } from '../../../data/teams/nwsl/utah-royals';
import { team as angelCity } from '../../../data/teams/nwsl/angel-city';
import { team as northCarolinaCourage } from '../../../data/teams/nwsl/north-carolina-courage';
import { team as orlandoPride } from '../../../data/teams/nwsl/orlando-pride';
import { team as denverSummit } from '../../../data/teams/nwsl/denver-summit';
import { team as bayFc } from '../../../data/teams/nwsl/bay-fc';
import { team as kansasCityCurrent } from '../../../data/teams/nwsl/kansas-city-current';
import { team as chicagoStars } from '../../../data/teams/nwsl/chicago-stars';
import { team as racingLouisville } from '../../../data/teams/nwsl/racing-louisville';


const allNwslTeams = [
  bostonLegacy, portlandThorns, sanDiegoWave, washingtonSpirit,
  gothamFc, seattleReign, houstonDash, utahRoyals, angelCity,
  northCarolinaCourage, orlandoPride, denverSummit, bayFc,
  kansasCityCurrent, chicagoStars, racingLouisville,
];
const teamByStandingsKey = new Map(allNwslTeams.map(t => [t.standingsKey, t]));
// Match opponent name string → team badge (handles name variants like "NJ/NY Gotham FC" → gothamFc)
const opponentBadgeMap = new Map<string, string | undefined>();
for (const t of allNwslTeams) {
  if (t.badge) {
    opponentBadgeMap.set(t.name, t.badge);
    opponentBadgeMap.set(t.name.replace(' FC', '').replace(' fc', ''), t.badge);
  }
}
// Extra aliases for schedule opponent name variants
opponentBadgeMap.set('NJ/NY Gotham FC', gothamFc.badge);
opponentBadgeMap.set('Portland Thorns FC', portlandThorns.badge);
opponentBadgeMap.set('San Diego Wave FC', sanDiegoWave.badge);
opponentBadgeMap.set('Utah Royals FC', utahRoyals.badge);
opponentBadgeMap.set('Racing Louisville FC', racingLouisville.badge);
function opponentBadge(opponent: string): string | undefined {
  return opponentBadgeMap.get(opponent);
}
const playedMatches = matches.filter(m => m.result);
const upcomingMatches = matches.filter(m => !m.result);
const lastThreeResults = playedMatches.slice(-3).reverse();
const nextThreeFixtures = upcomingMatches.slice(0, 3);

const lastUpdated = standingsLastUpdated;

const lastFiveResults = playedMatches.slice(-5).reverse();
const nextMatch = upcomingMatches[0];

const teamRow = nwslStandings.find(r => r.team === team.standingsKey)!;
const seasonRecord = teamRow;
const position = teamRow.rank;
const goalDiff = teamRow.goalsFor - teamRow.goalsAgainst;

const PLAYOFF_LINE = 8;

function formatDate(iso: string): string {
  const d = new Date(iso + 'T12:00:00Z');
  return d.toLocaleDateString('en-US', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
  });
}

function formatScore(match: typeof playedMatches[number]): string {
  if (!match.result) return '—';
  return `${match.result.teamScore}–${match.result.opponentScore}`;
}

function resultBadge(match: typeof playedMatches[number]): { label: string; color: string; style?: string } {
  if (!match.result) return { label: '—', color: 'bg-muted/20 text-muted' };
  const { teamScore, opponentScore } = match.result;
  if (teamScore > opponentScore) return { label: 'W', color: 'text-primary', style: 'background-color: var(--team-color)' };
  if (teamScore < opponentScore) return { label: 'L', color: 'bg-primary text-neutral' };
  return { label: 'D', color: 'bg-primary/20 text-primary' };
}

const title = `${team.name} 2026 — Results, Fixtures & Standings | Standd`;
const description = `${team.name} 2026 NWSL results, upcoming fixtures, standings, and where to watch every match. Updated weekly.`;
---

<style define:vars={{ teamColor: team.color }}>
  .tracker-body { --team-color: var(--teamColor); }
</style>

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SportsTeam",
    "name": team.name,
    "url": `https://standd.fan/nwsl/${team.slug}`,
    "sport": "Soccer",
    "memberOf": {
      "@type": "SportsOrganization",
      "name": "National Women's Soccer League",
      "alternateName": "NWSL",
      "url": "https://www.nwslsoccer.com/"
    },
    ...(team.badge ? { "logo": team.badge } : {}),
    "sameAs": [team.officialUrl]
  })} />
  <Header />
  <TeamTrackerSubNav leagueSlug="nwsl" teamSlug={team.slug} showHowToWatch showFreeTV showSquad />

  <main class="tracker-body flex-1">
    <!-- Editorial intro on cream -->
    <section class="bg-neutral pt-12 pb-12 border-b-[12px]" style="border-color: var(--team-color)">
      <div class="max-w-3xl mx-auto px-6">
        <p class="text-sm font-bold uppercase tracking-[0.2em] mb-3" style="color: var(--team-color)">NWSL · 2026 Season</p>
        <h1 class="font-display font-bold text-5xl md:text-7xl text-primary leading-[1.0] mb-8">
          {team.name} 2026 Season Tracker
        </h1>
        <p class="text-lg md:text-xl leading-relaxed text-primary/85">
          Results, fixtures, standings, and broadcast info for the {team.name} this season. Updated weekly.
        </p>
        <div class="mt-6 flex items-end justify-between gap-6 flex-wrap">
          {nextMatch && (
            <div id="match-countdown" data-date={nextMatch.date} data-time={nextMatch.time ?? ''}>
              <p class="text-xs text-muted font-bold uppercase tracking-wider mb-2">
                Next match · {nextMatch.homeAway === 'home' ? 'vs' : 'at'}{' '}{nextMatch.opponent}
              </p>
              <div class="flex items-center gap-2">
                <div class="flex items-end gap-1">
                  <span id="cd-days" class="font-display font-bold text-3xl text-primary tabular-nums leading-none">—</span>
                  <span class="text-xs text-muted font-bold uppercase tracking-wider mb-0.5">d</span>
                </div>
                <span class="text-primary/30 font-bold text-xl leading-none mb-0.5">:</span>
                <div class="flex items-end gap-1">
                  <span id="cd-hours" class="font-display font-bold text-3xl text-primary tabular-nums leading-none">—</span>
                  <span class="text-xs text-muted font-bold uppercase tracking-wider mb-0.5">h</span>
                </div>
                <span class="text-primary/30 font-bold text-xl leading-none mb-0.5">:</span>
                <div class="flex items-end gap-1">
                  <span id="cd-minutes" class="font-display font-bold text-3xl text-primary tabular-nums leading-none">—</span>
                  <span class="text-xs text-muted font-bold uppercase tracking-wider mb-0.5">m</span>
                </div>
              </div>
            </div>
          )}
          {lastFiveResults.length > 0 && (
            <div class="flex flex-col items-end gap-2">
              <span class="text-xs text-muted uppercase tracking-wider font-bold">Form</span>
              <div class="flex items-center gap-1.5">
                {lastFiveResults.map(m => {
                  const b = resultBadge(m);
                  return (
                    <span class={`inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-bold ${b.color}`} style={b.style ?? ''}>
                      {b.label}
                    </span>
                  );
                })}
              </div>
            </div>
          )}
        </div>
        <p class="mt-4 text-sm text-muted">Last updated {lastUpdated}</p>
      </div>
    </section>

    <!-- Season-to-date stats -->
    <section class="bg-primary py-16">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="font-display font-bold text-3xl mb-8 uppercase tracking-wider" style="color: var(--team-color)">Season to date</h2>
        <div class="grid grid-cols-3 md:grid-cols-6 gap-px bg-neutral/10 rounded-2xl overflow-hidden">
          <Stat label="Played" value={String(seasonRecord.played)} color="var(--team-color)" />
          <Stat label="Wins" value={String(seasonRecord.wins)} color="var(--team-color)" />
          <Stat label="Draws" value={String(seasonRecord.draws)} color="var(--team-color)" />
          <Stat label="Losses" value={String(seasonRecord.losses)} color="var(--team-color)" />
          <Stat label="Goal diff" value={`${goalDiff > 0 ? '+' : ''}${goalDiff}`} color="var(--team-color)" />
          <Stat label="Position" value={`#${position}`} highlight={true} color="var(--team-color)" />
        </div>
      </div>
    </section>

    <!-- Next + Last on cream, equal-height cards -->
    <section class="bg-neutral py-16">
      <div class="max-w-5xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-10">
          <div>
            <h2 class="font-display font-bold text-3xl text-primary mb-6">Next 3 fixtures</h2>
            <ul class="space-y-3">
              {nextThreeFixtures.map(match => {
                const isHome = match.homeAway === 'home';
                return (
                  <li class={`overflow-hidden rounded-xl flex min-h-[140px] ${isHome ? 'bg-primary text-neutral' : 'bg-neutral border-2 border-primary text-primary'}`}>
                    <div class={`w-1.5 flex-shrink-0 ${isHome ? '' : 'bg-primary/20'}`} style={isHome ? 'background-color: var(--team-color)' : ''} />
                    <div class="flex flex-col gap-2 p-5 flex-1">
                      <div class="flex items-center justify-between">
                        <div class="flex items-baseline gap-2">
                          <span class={`font-display font-bold tabular text-lg ${isHome ? '' : 'text-primary'}`} style={isHome ? 'color: var(--team-color)' : ''}>{formatDate(match.date)}</span>
                          {match.time && <span class={`font-display font-bold text-base ${isHome ? 'text-neutral/60' : 'text-primary/50'}`}>{match.time} ET</span>}
                        </div>
                        <span class={`text-xs uppercase tracking-wider font-bold px-2 py-1 rounded ${isHome ? 'bg-neutral/10 text-neutral/60' : 'bg-primary/10 text-primary/50'}`}>
                          {isHome ? 'HOME' : 'AWAY'}
                        </span>
                      </div>
                      <p class="font-display font-bold text-xl leading-tight">
                        {isHome ? 'vs' : 'at'}{' '}{match.opponent}
                      </p>
                      <div class="mt-auto flex flex-col gap-2">
                        <div class="flex flex-wrap items-center gap-1.5">
                          <span class={`text-sm ${isHome ? 'text-neutral/70' : 'text-muted'}`}>{match.venue} ·</span>
                          {match.broadcast.map(b => <Broadcaster name={b} />)}
                        </div>
                        <a
                          href={team.ticketsUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="self-start text-xs font-bold text-primary px-3 py-1 rounded-full hover:opacity-80 transition-opacity"
                          style="background-color: var(--team-color)"
                        >
                          Get tickets →
                        </a>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>

          <div>
            <h2 class="font-display font-bold text-3xl text-primary mb-6">Last 3 results</h2>
            <ul class="space-y-3">
              {lastThreeResults.map(match => {
                const badge = resultBadge(match);
                return (
                  <li class="bg-neutral border-2 border-primary p-5 rounded-xl flex flex-col gap-2 min-h-[140px]">
                    <div class="flex items-center justify-between">
                      <span class="font-display font-bold tabular text-primary text-lg">{formatDate(match.date)}</span>
                      <div class="flex items-center gap-2">
                        <span class={`text-xs font-display font-bold px-2 py-1 rounded ${badge.color}`} style={badge.style ?? ''}>
                          {badge.label}
                        </span>
                        <span class="font-display font-bold tabular text-2xl text-primary">
                          {formatScore(match)}
                        </span>
                      </div>
                    </div>
                    <p class="font-display font-bold text-xl text-primary leading-tight">
                      {match.homeAway === 'home' ? 'vs' : 'at'}{' '}{match.opponent}
                    </p>
                    <div class="mt-auto flex flex-col gap-2">
                      <span class="text-sm text-muted">{match.venue}</span>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- NWSL Standings -->
    <section class="bg-neutral py-16">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="font-display font-bold text-3xl text-primary mb-2">NWSL standings</h2>
        <p class="text-muted text-sm mb-6">Top 8 teams qualify for playoffs. {team.name}'s row is highlighted.</p>
        <div class="overflow-x-auto bg-neutral border-2 border-primary rounded-2xl">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-primary text-neutral text-left">
                <th class="px-2 py-3 font-bold tabular w-10">#</th>
                <th class="px-4 py-3 font-bold">Team</th>
                <th class="px-2 py-3 font-bold tabular text-right w-8">P</th>
                <th class="px-2 py-3 font-bold tabular text-right w-8">W</th>
                <th class="px-2 py-3 font-bold tabular text-right w-8">D</th>
                <th class="px-2 py-3 font-bold tabular text-right w-8">L</th>
                <th class="px-2 py-3 font-bold tabular text-right w-8">GD</th>
                <th class="px-3 py-3 font-bold tabular text-right w-12">PTS</th>
              </tr>
            </thead>
            <tbody>
              {nwslStandings.map((row, i) => {
                const pos = i + 1;
                const isTeam = row.team === team.standingsKey;
                const inPlayoffs = pos !== Math.max(pos, PLAYOFF_LINE + 1);
                const gd = row.goalsFor - row.goalsAgainst;
                const atCutoff = pos === PLAYOFF_LINE;
                const trClass = `border-b border-primary/10 ${isTeam ? 'font-bold' : inPlayoffs ? 'bg-primary/[0.03]' : ''}`;
                const trStyle = isTeam ? 'background-color: color-mix(in srgb, var(--team-color) 15%, transparent)' : undefined;
                const rankClass = `inline-flex items-center justify-center w-7 h-7 rounded-full font-bold text-xs ${inPlayoffs ? 'text-primary' : 'bg-muted/15 text-muted'}`;
                const rankStyle = inPlayoffs ? 'background-color: var(--team-color)' : undefined;
                return [
                  <tr class={trClass} style={trStyle}>
                    <td class="px-2 py-3 tabular">
                      <span class={rankClass} style={rankStyle}>
                        {pos}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-primary">
                      <div class="flex items-center gap-2">
                        {(() => { const tc = teamByStandingsKey.get(row.team); return tc?.badge ? <img src={tc.badge} alt="" width="18" height="18" class="flex-shrink-0 object-contain" /> : null; })()}
                        {standingsDisplayName(row.team)}
                      </div>
                    </td>
                    <td class="px-2 py-3 tabular text-right">{row.played}</td>
                    <td class="px-2 py-3 tabular text-right">{row.wins}</td>
                    <td class="px-2 py-3 tabular text-right">{row.draws}</td>
                    <td class="px-2 py-3 tabular text-right">{row.losses}</td>
                    <td class="px-2 py-3 tabular text-right text-muted">{gd > 0 ? '+' : ''}{gd}</td>
                    <td class="px-4 py-3 tabular text-right font-bold text-primary">{row.points}</td>
                  </tr>,
                  atCutoff && (
                    <tr aria-hidden="true">
                      <td colspan="8" class="text-primary text-xs font-bold uppercase tracking-[0.2em] px-4 py-2 text-center" style="background-color: var(--team-color)">
                        ↑ Playoff line · ↓ Outside the playoffs
                      </td>
                    </tr>
                  ),
                ];
              })}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Full remaining schedule (collapsed behind toggle) -->
    <section class="bg-neutral py-16">
      <div class="max-w-5xl mx-auto px-6">
        <div class="flex items-center gap-3 mb-2">
          <h2 class="font-display font-bold text-3xl text-primary">Full remaining schedule</h2>
          <button
            id="schedule-toggle"
            aria-expanded="false"
            aria-controls="schedule-list"
            aria-label="Toggle full schedule"
            class="hover:opacity-70 transition-opacity"
            style="color: var(--team-color)"
          >
            <span id="schedule-toggle-icon" class="block text-4xl leading-none" style="transition: transform 0.3s ease;">↓</span>
          </button>
        </div>
        <p class="text-muted text-sm mb-6">All upcoming {team.name} fixtures this season.</p>
        <ul id="schedule-list" class="space-y-3 overflow-hidden" style="max-height: 0; transition: max-height 0.4s ease;">
          {upcomingMatches.map(match => {
            const isHome = match.homeAway === 'home';
            return (
              <li class={`overflow-hidden rounded-xl flex min-h-[140px] ${isHome ? 'bg-primary text-neutral' : 'bg-neutral border-2 border-primary text-primary'}`}>
                <div class={`w-1.5 flex-shrink-0 ${isHome ? '' : 'bg-primary/20'}`} style={isHome ? 'background-color: var(--team-color)' : ''} />
                <div class="flex flex-col gap-2 p-5 flex-1">
                  <div class="flex items-center justify-between">
                    <div class="flex items-baseline gap-2">
                      <span class={`font-display font-bold tabular text-lg ${isHome ? '' : 'text-primary'}`} style={isHome ? 'color: var(--team-color)' : ''}>{formatDate(match.date)}</span>
                      {match.time && <span class={`font-display font-bold text-base ${isHome ? 'text-neutral/60' : 'text-primary/50'}`}>{match.time} ET</span>}
                    </div>
                    <span class={`text-xs uppercase tracking-wider font-bold px-2 py-1 rounded ${isHome ? 'bg-neutral/10 text-neutral/60' : 'bg-primary/10 text-primary/50'}`}>
                      {isHome ? 'HOME' : 'AWAY'}
                    </span>
                  </div>
                  <p class="font-display font-bold text-xl leading-tight">
                    {isHome ? 'vs' : 'at'}{' '}{match.opponent}
                  </p>
                  <div class="mt-auto flex flex-col gap-2">
                    <div class="flex flex-col gap-0.5">
                      <span class={`text-sm ${isHome ? 'text-neutral/70' : 'text-muted'}`}>{match.venue}</span>
                      <span class={`text-sm ${isHome ? 'text-neutral/50' : 'text-muted/70'}`}>{match.broadcast.join(', ')}</span>
                    </div>
                    <a
                      href={team.officialUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="self-start text-xs font-bold text-primary px-3 py-1 rounded-full hover:opacity-80 transition-opacity"
                      style="background-color: var(--team-color)"
                    >
                      Get tickets →
                    </a>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <EmailSignup />

    <!-- Closer -->
    <section class="bg-neutral py-12">
      <div class="max-w-5xl mx-auto px-6">
        <p class="text-sm text-muted leading-relaxed max-w-2xl">
          Data sourced from NWSLsoccer.com and <a href={team.officialUrl} target="_blank" rel="noopener noreferrer" class="font-bold hover:underline" style="color: var(--team-color)">{new URL(team.officialUrl).hostname.replace('www.', '')}</a>. If you spot something wrong, email <a href="mailto:ro@standd.fan" class="font-bold hover:underline" style="color: var(--team-color)">ro@standd.fan</a>.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  const countdownEl = document.getElementById('match-countdown') as HTMLElement | null;
  if (countdownEl) {
    const matchDate = countdownEl.dataset.date!;
    const matchTime = countdownEl.dataset.time!;
    const daysEl = document.getElementById('cd-days')!;
    const hoursEl = document.getElementById('cd-hours')!;
    const minutesEl = document.getElementById('cd-minutes')!;
    const labelEl = countdownEl.querySelector('p')!;

    function buildTarget(): Date {
      if (matchTime) {
        const [time, ampm] = matchTime.split(' ');
        let [h, m] = time.split(':').map(Number);
        if (ampm === 'PM' && h !== 12) h += 12;
        if (ampm === 'AM' && h === 12) h = 0;
        const hh = String(h).padStart(2, '0');
        const mm = String(m).padStart(2, '0');
        return new Date(`${matchDate}T${hh}:${mm}:00-04:00`);
      }
      return new Date(matchDate + 'T00:00:00');
    }

    const target = buildTarget();
    const pad = (n: number) => String(n).padStart(2, '0');
    const IN_PROGRESS_MS = 2 * 60 * 60 * 1000;

    function updateCountdown() {
      const diff = target.getTime() - Date.now();

      if (diff <= 0 && Math.abs(diff) < IN_PROGRESS_MS) {
        labelEl.textContent = 'Let\'s go!';
        daysEl.closest('.flex.items-end')!.classList.add('hidden');
        hoursEl.closest('.flex.items-end')!.classList.add('hidden');
        minutesEl.closest('.flex.items-end')!.classList.add('hidden');
        (document.querySelectorAll('#match-countdown .text-primary\\/30') as NodeListOf<HTMLElement>).forEach(el => el.classList.add('hidden'));
        return;
      }

      if (diff <= 0) return;

      daysEl.textContent = String(Math.floor(diff / 86400000));
      hoursEl.textContent = pad(Math.floor((diff % 86400000) / 3600000));
      minutesEl.textContent = pad(Math.floor((diff % 3600000) / 60000));
    }

    updateCountdown();
    setInterval(updateCountdown, 60000);
  }

  const btn = document.getElementById('schedule-toggle');
  const list = document.getElementById('schedule-list') as HTMLElement | null;
  const icon = document.getElementById('schedule-toggle-icon') as HTMLElement | null;

  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    if (list) {
      list.style.maxHeight = expanded ? '0' : `${list.scrollHeight}px`;
    }
    if (icon) {
      icon.style.transform = expanded ? '' : 'rotate(180deg)';
    }
  });
</script>
