---
// wnba-redesign/astro/pages/wnba/index.astro
//
// Drop-in replacement for src/pages/wnba/index.astro.
// Renders the redesigned WNBA league page using the "Primetime" identity.
//
// Prerequisites (done once, not per page):
//   • Add WNBA tokens to src/styles/global.css (see styles/wnba-tokens.css)
//   • Extend tailwind.config.mjs with the new color + fontFamily entries
//   • Extend WNBATeamConfig in src/data/shared/types.ts (see types-patch.ts)
//   • Add short / city / shortName / colorAlt / conference / expansion fields
//     to each src/data/teams/wnba/*.ts file (15 files, sample shown below)
//   • Copy src/data/wnba/featured-players.ts + broadcasters.ts from this folder

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

import { getStandings, getUpcomingGames } from '../../data/wnba/queries';
import { getPlayerStats } from '../../data/wnba/queries';

import { team as atlantaDream }         from '../../data/teams/wnba/atlanta-dream';
import { team as chicagoSky }           from '../../data/teams/wnba/chicago-sky';
import { team as connecticutSun }       from '../../data/teams/wnba/connecticut-sun';
import { team as dallasWings }          from '../../data/teams/wnba/dallas-wings';
import { team as goldenStateValkyries } from '../../data/teams/wnba/golden-state-valkyries';
import { team as indianaFever }         from '../../data/teams/wnba/indiana-fever';
import { team as lasVegasAces }         from '../../data/teams/wnba/las-vegas-aces';
import { team as losAngelesSparks }     from '../../data/teams/wnba/los-angeles-sparks';
import { team as minnesotaLynx }        from '../../data/teams/wnba/minnesota-lynx';
import { team as newYorkLiberty }       from '../../data/teams/wnba/new-york-liberty';
import { team as phoenixMercury }       from '../../data/teams/wnba/phoenix-mercury';
import { team as portlandFire }         from '../../data/teams/wnba/portland-fire';
import { team as seattleStorm }         from '../../data/teams/wnba/seattle-storm';
import { team as torontoTempo }         from '../../data/teams/wnba/toronto-tempo';
import { team as washingtonMystics }    from '../../data/teams/wnba/washington-mystics';

import { featuredPlayers } from '../../data/wnba/featured-players';

import WnbaHero          from '../../components/wnba/WnbaHero.astro';
import WnbaSlateRibbon   from '../../components/wnba/WnbaSlateRibbon.astro';
import WnbaStandings     from '../../components/wnba/WnbaStandings.astro';
import WnbaPlayerCard    from '../../components/wnba/WnbaPlayerCard.astro';
import WnbaTeamCard      from '../../components/wnba/WnbaTeamCard.astro';
import WnbaHowToWatchBand from '../../components/wnba/WnbaHowToWatchBand.astro';

// ── Team configs ────────────────────────────────────────────────────────────
const allTeams = [
  atlantaDream, chicagoSky, connecticutSun, dallasWings,
  goldenStateValkyries, indianaFever, lasVegasAces, losAngelesSparks,
  minnesotaLynx, newYorkLiberty, phoenixMercury, portlandFire,
  seattleStorm, torontoTempo, washingtonMystics,
];
const teamBySlug = Object.fromEntries(allTeams.map((t) => [t.slug, t]));

// ── Data fetch ──────────────────────────────────────────────────────────────
const standings = await getStandings();
const upcoming  = await getUpcomingGames(7);   // 7-day horizon
const stats     = await getPlayerStats(featuredPlayers.map((p) => p.espnId));

const standingBySlug = Object.fromEntries(standings.map((s) => [s.team, s]));
const statsByEspnId  = Object.fromEntries(stats.map((s) => [s.espn_id, s]));

// ── Hero meta ───────────────────────────────────────────────────────────────
const now = new Date();
const lastUpdated = now.toLocaleString('en-US', {
  timeZone: 'America/New_York',
  weekday: 'short', month: 'short', day: 'numeric',
  hour: 'numeric', minute: '2-digit',
}).replace(',', ' ·') + ' ET';

const thisWeekGames = upcoming.length;

// "Through games of June 4" — latest standings update or now
const asOfDate = now.toLocaleDateString('en-US', {
  timeZone: 'America/New_York', month: 'long', day: 'numeric',
});

// ── SEO ─────────────────────────────────────────────────────────────────────
const title = 'WNBA 2026 Standings, Schedule & Teams — Standd';
const description = 'Full WNBA 2026 standings, schedules, and broadcast guides for all 15 teams. Find out where every game airs — ION, Prime Video, ESPN, and more — in one place.';
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SportsOrganization",
    "name": "Women's National Basketball Association",
    "alternateName": "WNBA",
    "url": "https://standd.fan/wnba",
    "sport": "Basketball"
  })} />

  <Header />

  <main class="flex-1 bg-ink text-bone">
    <WnbaHero
      lastUpdated={lastUpdated}
      thisWeekGames={thisWeekGames}
      seasonPhase="Week 6"
    />

    <WnbaSlateRibbon upcoming={upcoming} teamBySlug={teamBySlug} />

    <WnbaStandings standings={standings} teamBySlug={teamBySlug} asOfDate={asOfDate} />

    {/* Players to watch */}
    <section id="players" class="bg-ink border-t border-white/[0.06]">
      <div class="max-w-wrap mx-auto px-6 py-16 md:py-20">
        <div class="flex flex-wrap items-end justify-between gap-4 mb-10">
          <div>
            <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-lane mb-3">
              Showing {Math.min(4, featuredPlayers.length)} of {featuredPlayers.length} · early-season leaders
            </p>
            <h2 class="wnba-court-display text-bone text-5xl md:text-7xl">Players to watch.</h2>
          </div>
          <a href="/wnba/players" class="text-sm font-court font-black uppercase tracking-wider text-bone border-b-2 border-bone/20 hover:border-lane pb-0.5 transition-colors whitespace-nowrap">
            See all {featuredPlayers.length} players →
          </a>
        </div>

        <div class="grid md:grid-cols-2 gap-3">
          {featuredPlayers.slice(0, 4).map((p) => {
            const team = teamBySlug[p.teamSlug];
            if (!team) return null;
            return (
              <WnbaPlayerCard
                player={p}
                team={team}
                stats={statsByEspnId[p.espnId] ?? null}
              />
            );
          })}
        </div>
      </div>
    </section>

    {/* Team trackers — bone interlude */}
    <section id="teams" class="bg-bone text-ink relative">
      <div class="h-1 bg-lane"></div>
      <div class="max-w-wrap mx-auto px-6 py-16 md:py-20">
        <div class="flex flex-wrap items-end justify-between gap-4 mb-10">
          <div>
            <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-lane mb-3">Fifteen franchises · one page each</p>
            <h2 class="wnba-court-display text-ink text-5xl md:text-7xl">Team trackers.</h2>
            <p class="mt-4 text-sm text-ink/65 max-w-xl leading-relaxed">
              Schedule, broadcast info, roster, recaps. Each tracker keeps its own team color so your team's page feels like home.
            </p>
          </div>
          <p class="font-mono text-xs text-ink/50 max-w-[280px] tabular-nums">
            Three new shields debut in 2026 — <span class="text-lane font-semibold">Toronto Tempo</span>, <span class="text-lane font-semibold">Portland Fire</span>, and <span class="text-lane font-semibold">Golden State Valkyries</span>.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {allTeams.map((t) => (
            <WnbaTeamCard team={t} standing={standingBySlug[t.slug] ?? null} />
          ))}
        </div>
      </div>
    </section>

    <WnbaHowToWatchBand />
  </main>

  <Footer />
</BaseLayout>
