      <!-- Body -->
      <div class="modal-body">
        <!-- Tab bar -->
        <div class="modal-tab-bar" role="tablist">
          <button class="modal-tab active" data-tab="pergame" role="tab">Per game</button>
          <button class="modal-tab" data-tab="career" role="tab">Career</button>
          <button class="modal-tab" data-tab="splits" role="tab">Splits</button>
        </div>

        <!-- Per game tab -->
        <div id="tab-pergame" class="tab-pane active">
          <div class="stat-tiles" id="tiles-pergame"></div>
        </div>

        <!-- Career tab -->
        <div id="tab-career" class="tab-pane">
          <div class="stat-tiles" id="tiles-career"></div>
        </div>

        <!-- Splits tab (home/away in the data we do have) -->
        <div id="tab-splits" class="tab-pane">
          <div id="splits-wrap"></div>
        </div>
      </div>
    </div>
  </div>

  <Footer />
</BaseLayout>

<script define:vars={{ playersJson, teamColor, teamName: team.name }}>
  const PLAYERS = JSON.parse(playersJson);
  const TEAM_COLOR = teamColor;

  // ---- Helpers ----
  function fmt(v, dec = 1) { return v == null ? '—' : Number(v).toFixed(dec); }
  function fmtPct(v) {
    if (v == null) return '—';
    const pct = v > 1 ? v : v * 100;
    return pct.toFixed(1);
  }
  function playerSlug(name) {
    return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  }

  // ---- State ----
  let currentView = localStorage.getItem('roster-view') || 'cards';
  let currentPos = 'all';
  let currentSplit = 'season';
  let currentQuery = '';
  let sortCol = 'ppg';
  let sortDir = 'desc';
  let openSlug = null;

  // ---- DOM refs ----
  const overlay = document.getElementById('modal-overlay');
  const viewCards = document.getElementById('view-cards');
  const viewTable = document.getElementById('view-table');
  const cardsGrid = document.getElementById('cards-grid');
  const tableBody = document.getElementById('table-body');
  const searchInput = document.getElementById('roster-search');

  // ---- View toggle ----
  function setView(v) {
    currentView = v;
    localStorage.setItem('roster-view', v);
    viewCards.style.display = v === 'cards' ? 'block' : 'none';
    viewTable.style.display = v === 'table' ? 'block' : 'none';
    document.querySelectorAll('.view-btn').forEach(b => {
      b.classList.toggle('active', b.dataset.view === v);
    });
  }
  setView(currentView);

  document.querySelectorAll('.view-btn').forEach(btn => {
    btn.addEventListener('click', () => setView(btn.dataset.view));
  });

  // ---- Position filter ----
  document.querySelectorAll('[data-pos]').forEach(btn => {
    btn.addEventListener('click', () => {
      currentPos = btn.dataset.pos;
      document.querySelectorAll('[data-pos]').forEach(b => b.classList.toggle('active', b.dataset.pos === currentPos));
      applyFilters();
    });
  });

  // ---- Split toggle ----
  document.querySelectorAll('[data-split]').forEach(btn => {
    btn.addEventListener('click', () => {
      currentSplit = btn.dataset.split;
      document.querySelectorAll('[data-split]').forEach(b => b.classList.toggle('active', b.dataset.split === currentSplit));
      updateStatValues();
    });
  });

  function updateStatValues() {
    // Cards
    document.querySelectorAll('.card-stat-val[data-season]').forEach(el => {
      el.textContent = currentSplit === 'season' ? el.dataset.season : el.dataset.career;
    });
    // Table
    document.querySelectorAll('td[data-season]').forEach(el => {
      el.textContent = currentSplit === 'season' ? el.dataset.season : el.dataset.career;
    });
  }

  // ---- Search ----
  searchInput.addEventListener('input', () => {
    currentQuery = searchInput.value.toLowerCase().trim();
    applyFilters();
  });

  // ---- Filter rows ----
  function applyFilters() {
    const cards = cardsGrid.querySelectorAll('li[data-slug]');
    const rows = tableBody.querySelectorAll('tr[data-slug]');

    function matches(el) {
      const pos = el.dataset.pos;
      const name = el.dataset.name;
      const num = (el.dataset.num || '').toString();
      if (currentPos !== 'all' && pos !== currentPos) return false;
      if (currentQuery && !name.includes(currentQuery) && !num.includes(currentQuery)) return false;
      return true;
    }

    cards.forEach(el => { el.style.display = matches(el) ? '' : 'none'; });
    rows.forEach(el => { el.style.display = matches(el) ? '' : 'none'; });
  }

  // ---- Table sort ----
  const colGetters = {
    num:  p => parseInt(p.num) || 0,
    name: p => p.name,
    pos:  p => p.pos,
    gp:   p => currentSplit === 'season' ? (p.season.gp ?? -1) : (p.career.gp ?? -1),
    mpg:  p => currentSplit === 'season' ? (p.season.mpg ?? -1) : (p.career.mpg ?? -1),
    ppg:  p => currentSplit === 'season' ? (p.season.ppg ?? -1) : (p.career.ppg ?? -1),
    rpg:  p => currentSplit === 'season' ? (p.season.rpg ?? -1) : (p.career.rpg ?? -1),
    apg:  p => currentSplit === 'season' ? (p.season.apg ?? -1) : (p.career.apg ?? -1),
    spg:  p => currentSplit === 'season' ? (p.season.spg ?? -1) : (p.career.spg ?? -1),
    bpg:  p => currentSplit === 'season' ? (p.season.bpg ?? -1) : (p.career.bpg ?? -1),
    tov:  p => currentSplit === 'season' ? (p.season.tov ?? -1) : (p.career.tov ?? -1),
    fgp:  p => currentSplit === 'season' ? (p.season.fgp ?? -1) : (p.career.fgp ?? -1),
    tpp:  p => currentSplit === 'season' ? (p.season.tpp ?? -1) : (p.career.tpp ?? -1),
    ftp:  p => currentSplit === 'season' ? (p.season.ftp ?? -1) : (p.career.ftp ?? -1),
  };

  document.querySelectorAll('.roster-table th[data-col]').forEach(th => {
    th.addEventListener('click', () => {
      const col = th.dataset.col;
      if (sortCol === col) {
        sortDir = sortDir === 'desc' ? 'asc' : 'desc';
      } else {
        sortCol = col;
        sortDir = col === 'name' || col === 'pos' || col === 'num' ? 'asc' : 'desc';
      }
      document.querySelectorAll('.roster-table th').forEach(h => h.classList.remove('active'));
      th.classList.add('active');
      document.querySelectorAll('.sort-arrow').forEach(s => s.textContent = '');
      const arrow = th.querySelector('.sort-arrow');
      if (arrow) arrow.textContent = sortDir === 'desc' ? '▼' : '▲';
      sortTable();
    });
  });

  function sortTable() {
    const rows = Array.from(tableBody.querySelectorAll('tr[data-slug]'));
    const getter = colGetters[sortCol] || (() => 0);

    // Map slug -> player data
    const slugMap = {};
    PLAYERS.forEach(p => { slugMap[p.espn_id] = p; });

    rows.sort((a, b) => {
      const pa = slugMap[a.dataset.slug];
      const pb = slugMap[b.dataset.slug];
      if (!pa || !pb) return 0;
      const va = getter(pa);
      const vb = getter(pb);
      if (typeof va === 'string') return sortDir === 'asc' ? va.localeCompare(vb) : vb.localeCompare(va);
      return sortDir === 'asc' ? va - vb : vb - va;
    });

    rows.forEach((row, i) => {
      row.style.background = i % 2 === 0
        ? `color-mix(in srgb, ${TEAM_COLOR} 4%, transparent)`
        : 'transparent';
      tableBody.appendChild(row);
    });
  }

  // ---- Card/row click → open modal ----
  cardsGrid.addEventListener('click', e => {
    const card = e.target.closest('[data-slug]');
    if (card) openModal(card.dataset.slug);
  });
  tableBody.addEventListener('click', e => {
    const row = e.target.closest('tr[data-slug]');
    if (row) openModal(row.dataset.slug);
  });

  // Leaders cells
  document.querySelectorAll('[data-open-player]').forEach(btn => {
    btn.addEventListener('click', () => openModal(btn.dataset.openPlayer));
  });

  // ---- Modal ----
  function getVisiblePlayers() {
    // All players matching current filter, in current sort order
    const slugMap = {};
    PLAYERS.forEach(p => { slugMap[p.espn_id] = p; });
    const rows = Array.from(tableBody.querySelectorAll('tr[data-slug]'));
    return rows
      .filter(r => r.style.display !== 'none')
      .map(r => slugMap[r.dataset.slug])
      .filter(Boolean);
  }

  function openModal(slug) {
    openSlug = slug;
    const p = PLAYERS.find(pl => pl.espn_id === slug);
    if (!p) return;
    renderModal(p);
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
    // Deep link
    history.replaceState(null, '', `#/player/${playerSlug(p.name)}`);
  }

  function closeModal() {
    openSlug = null;
    overlay.classList.remove('open');
    document.body.style.overflow = '';
    history.replaceState(null, '', location.pathname);
  }

  function navigateModal(dir) {
    const visible = getVisiblePlayers();
    const idx = visible.findIndex(p => p.espn_id === openSlug);
    if (idx === -1) return;
    const next = visible[(idx + dir + visible.length) % visible.length];
    if (next) openModal(next.espn_id);
  }

  function renderModal(p) {
    const s = p.season;
    const c = p.career;

    // Avatar
    const img = document.getElementById('modal-avatar-img');
    const fallback = document.getElementById('modal-avatar-fallback');
    img.src = p.photo;
    img.alt = p.name;
    img.style.display = 'block';
    fallback.style.display = 'none';
    img.onerror = () => {
      img.style.display = 'none';
      const initials = p.name.trim().split(/\s+/).map(w => w[0]).join('').slice(0, 2).toUpperCase();
      fallback.textContent = initials;
      fallback.style.display = 'grid';
    };

    // Header text
    const rookieBadge = p.rookie
      ? `<span style="display:inline-block;padding:2px 8px;border-radius:4px;background:var(--color-accent);color:var(--color-primary);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;vertical-align:middle;margin-left:10px;">Rookie</span>`
      : '';
    document.getElementById('modal-eyebrow').textContent = `${teamName} · WNBA · #${p.num || '—'}`;
    document.getElementById('modal-name').innerHTML = p.name + rookieBadge;

    const attrs = document.getElementById('modal-attrs');
    const parts = [
      `<strong style="color:#fff">${p.posLong}</strong>`,
      p.ht !== '—' ? p.ht : null,
      p.college !== '—' ? p.college : null,
    ].filter(Boolean);
    attrs.innerHTML = parts.map(part => `<span>${part}</span>`).join('<span style="opacity:0.35">·</span>');

    // Hero stats
    const heroStats = document.getElementById('modal-hero-stats');
    const stats5 = [
      { l: 'PPG', v: fmt(s.ppg) },
      { l: 'RPG', v: fmt(s.rpg) },
      { l: 'APG', v: fmt(s.apg) },
      { l: 'FG%', v: fmtPct(s.fgp) },
      { l: 'FT%', v: fmtPct(s.ftp) },
    ];
    heroStats.innerHTML = stats5.map((m, i) => `
      <div style="padding:18px 20px;${i < stats5.length - 1 ? 'border-right:1px solid rgba(255,255,255,0.10);' : ''}">
        <div style="font-family:var(--font-mono);font-weight:600;font-size:36px;line-height:1;letter-spacing:-0.04em;color:#fff;font-variant-numeric:tabular-nums;">${m.v}</div>
        <div style="font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.18em;color:rgba(255,255,255,0.65);margin-top:6px;">${m.l}</div>
      </div>
    `).join('');

    // Per game tiles
    renderTiles('tiles-pergame', s);
    renderTiles('tiles-career', c);

    // Splits — we show season vs career comparison
    const splitsWrap = document.getElementById('splits-wrap');
    const thStyle = 'padding:10px 12px;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.16em;color:var(--color-muted);background:rgba(15,42,45,0.04);';
    const tdL = 'padding:12px;font-family:var(--font-display);font-weight:700;font-size:13px;border-top:1px solid rgba(15,42,45,0.08);';
    const tdR = 'padding:12px;text-align:right;font-family:var(--font-mono);font-size:13px;font-weight:600;font-variant-numeric:tabular-nums;border-top:1px solid rgba(15,42,45,0.08);';
    const th = (label, tip) => `<th title="${tip}" style="${thStyle}text-align:right;cursor:help">${label}</th>`;
    const seasonRows = p.seasons.map(({ year, stats: st }, i) => `
      <tr${i % 2 === 1 ? ` style="background:rgba(15,42,45,0.025)"` : ''}>
        <td style="${tdL}">${year ?? '2026'}</td>
        <td style="${tdR}">${st.gp ?? '—'}</td>
        <td style="${tdR}">${fmt(st.mpg)}</td>
        <td style="${tdR}">${fmt(st.ppg)}</td>
        <td style="${tdR}">${fmt(st.rpg)}</td>
        <td style="${tdR}">${fmt(st.apg)}</td>
        <td style="${tdR}">${fmt(st.spg)}</td>
        <td style="${tdR}">${fmt(st.bpg)}</td>
        <td style="${tdR}">${fmt(st.tov)}</td>
        <td style="${tdR}">${fmtPct(st.fgp)}</td>
        <td style="${tdR}">${fmtPct(st.tpp)}</td>
        <td style="${tdR}">${fmtPct(st.ftp)}</td>
      </tr>
    `).join('');
    splitsWrap.innerHTML = `
      <div style="overflow-x:auto;">
      <table style="width:100%;border-collapse:separate;border-spacing:0;border:1px solid rgba(15,42,45,0.10);border-radius:12px;overflow:hidden;min-width:600px;">
        <thead>
          <tr>
            <th style="${thStyle}text-align:left">Season</th>
            ${th('GP',  'Games Played')}
            ${th('MPG', 'Minutes Per Game')}
            ${th('PPG', 'Points Per Game')}
            ${th('RPG', 'Rebounds Per Game')}
            ${th('APG', 'Assists Per Game')}
            ${th('SPG', 'Steals Per Game')}
            ${th('BPG', 'Blocks Per Game')}
            ${th('TOV', 'Turnovers Per Game')}
            ${th('FG%', 'Field Goal Percentage')}
            ${th('3P%', 'Three-Point Percentage')}
            ${th('FT%', 'Free Throw Percentage')}
          </tr>
        </thead>
        <tbody>
          ${seasonRows || `<tr><td colspan="12" style="padding:16px;text-align:center;color:var(--color-muted);font-size:13px;">No season data available</td></tr>`}
          <tr style="background:color-mix(in srgb, ${TEAM_COLOR} 4%, transparent);border-top:2px solid rgba(15,42,45,0.10)">
            <td style="${tdL}font-weight:700">Career</td>
            <td style="${tdR}">${c.gp ?? '—'}</td>
            <td style="${tdR}">${fmt(c.mpg)}</td>
            <td style="${tdR}">${fmt(c.ppg)}</td>
            <td style="${tdR}">${fmt(c.rpg)}</td>
            <td style="${tdR}">${fmt(c.apg)}</td>
            <td style="${tdR}">${fmt(c.spg)}</td>
            <td style="${tdR}">${fmt(c.bpg)}</td>
            <td style="${tdR}">${fmt(c.tov)}</td>
            <td style="${tdR}">${fmtPct(c.fgp)}</td>
            <td style="${tdR}">${fmtPct(c.tpp)}</td>
            <td style="${tdR}">${fmtPct(c.ftp)}</td>
          </tr>
        </tbody>
      </table>
      </div>
    `;

    // Activate first tab
    activateTab('pergame');
  }

  function renderTiles(containerId, stats) {
    const container = document.getElementById(containerId);
    const tiles = [
      { label: 'GP', value: stats.gp ?? '—', bold: false },
      { label: 'MPG', value: fmt(stats.mpg) },
      { label: 'PPG', value: fmt(stats.ppg), accent: true },
      { label: 'RPG', value: fmt(stats.rpg) },
      { label: 'APG', value: fmt(stats.apg) },
      { label: 'SPG', value: fmt(stats.spg) },
      { label: 'BPG', value: fmt(stats.bpg) },
      { label: 'TOV', value: fmt(stats.tov) },
      { label: 'FG%', value: fmtPct(stats.fgp) },
      { label: '3P%', value: fmtPct(stats.tpp) },
      { label: 'FT%', value: fmtPct(stats.ftp) },
    ];
    container.innerHTML = tiles.map(t => `
      <div style="background:${t.accent ? 'var(--color-primary)' : 'rgba(15,42,45,0.04)'};padding:14px 16px;border-radius:12px;display:flex;flex-direction:column;gap:4px;">
        <div style="font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.18em;opacity:0.6;color:${t.accent ? '#fff' : 'inherit'};">${t.label}</div>
        <div style="font-family:var(--font-mono);font-weight:600;font-size:24px;line-height:1;letter-spacing:-0.02em;font-variant-numeric:tabular-nums;color:${t.accent ? '#fff' : 'var(--color-primary)'};">${t.value}</div>
      </div>
    `).join('');
  }

  function activateTab(id) {
    document.querySelectorAll('.modal-tab').forEach(t => t.classList.toggle('active', t.dataset.tab === id));
    document.querySelectorAll('.tab-pane').forEach(p => p.classList.toggle('active', p.id === `tab-${id}`));
  }

  // Modal events
  document.getElementById('modal-close').addEventListener('click', closeModal);
  document.getElementById('modal-prev').addEventListener('click', () => navigateModal(-1));
  document.getElementById('modal-next').addEventListener('click', () => navigateModal(+1));

  overlay.addEventListener('click', e => { if (e.target === overlay) closeModal(); });

  document.querySelectorAll('.modal-tab').forEach(tab => {
    tab.addEventListener('click', () => activateTab(tab.dataset.tab));
  });

  document.addEventListener('keydown', e => {
    if (!openSlug) return;
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowLeft') navigateModal(-1);
    if (e.key === 'ArrowRight') navigateModal(+1);
  });

  // Row hover styles for table
  tableBody.addEventListener('mouseover', e => {
    const row = e.target.closest('tr[data-slug]');
    if (row) row.style.background = `color-mix(in srgb, ${TEAM_COLOR} 14%, transparent)`;
  });
  tableBody.addEventListener('mouseout', e => {
    const row = e.target.closest('tr[data-slug]');
    if (row) {
      const rows = Array.from(tableBody.querySelectorAll('tr[data-slug]'));
      const i = rows.indexOf(row);
      row.style.background = i % 2 === 0
        ? `color-mix(in srgb, ${TEAM_COLOR} 4%, transparent)`
        : 'transparent';
    }
  });

  // Custom tooltip for [data-tip] elements (works inside buttons + all browsers)
  const tip = document.createElement('div');
  tip.style.cssText = [
    'position:fixed','z-index:9999','pointer-events:none',
    'background:#111','color:#fff','font-size:12px','line-height:1.4',
    'padding:5px 10px','border-radius:6px','max-width:240px',
    'box-shadow:0 2px 8px rgba(0,0,0,0.35)',
    'opacity:0','transition:opacity 120ms','white-space:normal',
  ].join(';');
  document.body.appendChild(tip);

  document.addEventListener('mouseover', e => {
    const el = e.target && e.target.closest ? e.target.closest('[data-tip]') : null;
    if (!el) return;
    tip.textContent = el.getAttribute('data-tip') || '';
    tip.style.opacity = '1';
  });
  document.addEventListener('mousemove', e => {
    if (tip.style.opacity === '0') return;
    const gap = 12;
    let x = e.clientX + gap;
    let y = e.clientY + gap;
    const tw = tip.offsetWidth, tipH = tip.offsetHeight;
    if (x + tw > window.innerWidth - 8) x = e.clientX - tw - gap;
    if (y + tipH > window.innerHeight - 8) y = e.clientY - tipH - gap;
    tip.style.left = x + 'px';
    tip.style.top  = y + 'px';
  });
  document.addEventListener('mouseout', e => {
    const el = e.target && e.target.closest ? e.target.closest('[data-tip]') : null;
    if (el) tip.style.opacity = '0';
  });
</script>
