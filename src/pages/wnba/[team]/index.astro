---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import TeamTrackerSubNav from '../../../components/TeamTrackerSubNav.astro';
import Footer from '../../../components/Footer.astro';
import Broadcaster from '../../../components/Broadcaster.astro';
import { team as atlantaDream, matches as atlantaDreamMatches } from '../../../data/teams/wnba/atlanta-dream';
import { team as chicagoSky, matches as chicagoSkyMatches } from '../../../data/teams/wnba/chicago-sky';
import { team as connecticutSun, matches as connecticutSunMatches } from '../../../data/teams/wnba/connecticut-sun';
import { team as dallasWings, matches as dallasWingsMatches } from '../../../data/teams/wnba/dallas-wings';
import { team as goldenStateValkyries, matches as goldenStateValkyriesMatches } from '../../../data/teams/wnba/golden-state-valkyries';
import { team as indianaFever, matches as indianaFeverMatches } from '../../../data/teams/wnba/indiana-fever';
import { team as lasVegasAces, matches as lasVegasAcesMatches } from '../../../data/teams/wnba/las-vegas-aces';
import { team as losAngelesSparks, matches as losAngelesSparksMatches } from '../../../data/teams/wnba/los-angeles-sparks';
import { team as minnesotaLynx, matches as minnesotaLynxMatches } from '../../../data/teams/wnba/minnesota-lynx';
import { team as newYorkLiberty, matches as newYorkLibertyMatches } from '../../../data/teams/wnba/new-york-liberty';
import { team as phoenixMercury, matches as phoenixMercuryMatches } from '../../../data/teams/wnba/phoenix-mercury';
import { team as seattleStorm, matches as seattleStormMatches } from '../../../data/teams/wnba/seattle-storm';
import { team as washingtonMystics, matches as washingtonMysticsMatches } from '../../../data/teams/wnba/washington-mystics';
import { team as portlandFire, matches as portlandFireMatches } from '../../../data/teams/wnba/portland-fire';
import { team as torontoTempo, matches as torontoTempoMatches } from '../../../data/teams/wnba/toronto-tempo';
import type { TeamConfig, Match } from '../../../data/shared/types';

const allTeamData: Array<{ team: TeamConfig; matches: Match[] }> = [
  { team: atlantaDream, matches: atlantaDreamMatches },
  { team: chicagoSky, matches: chicagoSkyMatches },
  { team: connecticutSun, matches: connecticutSunMatches },
  { team: dallasWings, matches: dallasWingsMatches },
  { team: goldenStateValkyries, matches: goldenStateValkyriesMatches },
  { team: indianaFever, matches: indianaFeverMatches },
  { team: lasVegasAces, matches: lasVegasAcesMatches },
  { team: losAngelesSparks, matches: losAngelesSparksMatches },
  { team: minnesotaLynx, matches: minnesotaLynxMatches },
  { team: newYorkLiberty, matches: newYorkLibertyMatches },
  { team: phoenixMercury, matches: phoenixMercuryMatches },
  { team: portlandFire, matches: portlandFireMatches },
  { team: seattleStorm, matches: seattleStormMatches },
  { team: torontoTempo, matches: torontoTempoMatches },
  { team: washingtonMystics, matches: washingtonMysticsMatches },
];

export function getStaticPaths() {
  return [
    'atlanta-dream', 'chicago-sky', 'connecticut-sun', 'dallas-wings',
    'golden-state-valkyries', 'indiana-fever', 'las-vegas-aces', 'los-angeles-sparks',
    'minnesota-lynx', 'new-york-liberty', 'phoenix-mercury', 'portland-fire',
    'seattle-storm', 'toronto-tempo', 'washington-mystics',
  ].map(slug => ({ params: { team: slug } }));
}

const { team: teamSlug } = Astro.params;
const teamData = allTeamData.find(d => d.team.slug === teamSlug)!;
const { team, matches } = teamData;

const playedMatches = matches.filter(m => m.result);
const upcomingMatches = matches.filter(m => !m.result);
const nextMatch = upcomingMatches[0];
const nextThreeFixtures = upcomingMatches.slice(0, 3);
const lastThreeResults = playedMatches.slice(-3).reverse();
const lastFiveResults = playedMatches.slice(-5).reverse();

const gamesPlayed = playedMatches.length;
const wins = playedMatches.filter(m => m.result && m.result.teamScore > m.result.opponentScore).length;
const losses = playedMatches.filter(m => m.result && m.result.teamScore < m.result.opponentScore).length;
const progressPct = matches.length > 0 ? Math.round((gamesPlayed / matches.length) * 100) : 0;

// Win streak: count consecutive W from most recent played match
let streak = 0;
let streakLabel = '';
const reversed = [...playedMatches].reverse();
if (reversed.length > 0) {
  const firstResult = reversed[0].result!;
  const isWinStreak = firstResult.teamScore > firstResult.opponentScore;
  for (const m of reversed) {
    const r = m.result!;
    const isWin = r.teamScore > r.opponentScore;
    if (isWin === isWinStreak) streak++;
    else break;
  }
  streakLabel = isWinStreak ? `W${streak}` : `L${streak}`;
}

function formatDate(iso: string): string {
  const d = new Date(iso + 'T12:00:00Z');
  return d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
}

function formatScore(match: Match): string {
  if (!match.result) return '—';
  return `${match.result.teamScore}–${match.result.opponentScore}`;
}

function resultBadge(match: Match): { label: string; color: string; style?: string } {
  if (!match.result) return { label: '—', color: 'bg-muted/20 text-muted' };
  const { teamScore, opponentScore } = match.result;
  if (teamScore > opponentScore) return { label: 'W', color: 'text-primary', style: 'background-color: var(--team-color)' };
  if (teamScore < opponentScore) return { label: 'L', color: 'bg-primary text-neutral' };
  return { label: 'D', color: 'bg-primary/20 text-primary' };
}

const seasonComplete = upcomingMatches.length === 0 && playedMatches.length > 0;

const title = `${team.name} 2026 Season Tracker — Standd`;
const description = `${team.name} WNBA 2026 season tracker — schedule, results, and broadcast info.`;
---

<style define:vars={{ teamColor: team.color }}>
  .tracker-body { --team-color: var(--teamColor); }
</style>

<BaseLayout title={title} description={description}>
  <Header />
  <TeamTrackerSubNav leagueSlug="wnba" teamSlug={team.slug} showHowToWatch showPlayers />

  <main class="tracker-body flex-1">
    <!-- Hero header -->
    <section class="bg-neutral pt-12 pb-12 border-b-[12px]" style="border-color: var(--team-color)">
      <div class="max-w-3xl mx-auto px-6">
        <p class="text-sm font-bold uppercase tracking-[0.2em] mb-3" style="color: var(--team-color)">WNBA · 2026 Season</p>
        <h1 class="font-display font-bold text-5xl md:text-7xl text-primary leading-[1.0] mb-6">
          {team.name}
        </h1>

        {/* Season progress bar */}
        {matches.length > 0 && (
          <div class="mb-6">
            <div class="flex items-center justify-between text-xs text-muted font-bold uppercase tracking-wider mb-2">
              <span>{gamesPlayed} / {matches.length} games played</span>
              {streakLabel && <span>Current streak: {streakLabel}</span>}
            </div>
            <div class="h-2 bg-primary/10 rounded-full overflow-hidden">
              <div class="h-full rounded-full transition-all" style={`width: ${progressPct}%; background-color: var(--team-color)`} />
            </div>
            {gamesPlayed > 0 && (
              <p class="mt-2 text-sm text-muted">{wins}W · {losses}L</p>
            )}
          </div>
        )}

        {/* Next game hero */}
        {nextMatch && (
          <div class="rounded-2xl p-6 border-2 mt-4" style="border-color: var(--team-color)">
            <p class="text-xs font-bold uppercase tracking-wider text-muted mb-3">Next game</p>
            <div class="flex items-start justify-between gap-4 flex-wrap">
              <div>
                <p class="font-display font-bold text-2xl text-primary leading-tight">
                  {nextMatch.homeAway === 'home' ? 'vs ' : 'at '}{nextMatch.opponent}
                </p>
                <p class="mt-1 text-primary/70 text-sm">{formatDate(nextMatch.date)}{nextMatch.time ? ` · ${nextMatch.time} ET` : ''}</p>
                <p class="text-muted text-sm">{nextMatch.venue}</p>
                <div class="flex flex-wrap items-center gap-1.5 mt-2">
                  {nextMatch.broadcast.length > 0
                    ? nextMatch.broadcast.map(b => <Broadcaster name={b} />)
                    : <span class="text-xs text-muted">Broadcast TBD</span>
                  }
                </div>
              </div>
              {team.ticketsUrl && (
                <a
                  href={team.ticketsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-shrink-0 text-sm font-bold text-primary px-4 py-2 rounded-full hover:opacity-80 transition-opacity"
                  style="background-color: var(--team-color)"
                >
                  Get tickets →
                </a>
              )}
            </div>
          </div>
        )}

        {seasonComplete && (
          <div class="rounded-2xl p-6 border-2 mt-4 border-primary/20">
            <p class="font-display font-bold text-xl text-primary">Season complete</p>
            <p class="text-muted text-sm mt-1">The 2026 WNBA season has concluded for {team.name}.</p>
          </div>
        )}

        {matches.length === 0 && (
          <div class="rounded-2xl p-6 border-2 mt-4 border-primary/20">
            <p class="text-muted">Schedule coming soon. Check back after the data fetch runs.</p>
          </div>
        )}

        {lastFiveResults.length > 0 && (
          <div class="mt-6 flex items-center gap-3">
            <span class="text-xs text-muted uppercase tracking-wider font-bold">Form</span>
            <div class="flex items-center gap-1.5">
              {lastFiveResults.map(m => {
                const b = resultBadge(m);
                return (
                  <span class={`inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-bold ${b.color}`} style={b.style ?? ''}>
                    {b.label}
                  </span>
                );
              })}
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- Next + Last results -->
    {(nextThreeFixtures.length > 0 || lastThreeResults.length > 0) && (
      <section class="bg-neutral py-16">
        <div class="max-w-5xl mx-auto px-6">
          <div class="grid md:grid-cols-2 gap-10">
            {nextThreeFixtures.length > 0 && (
              <div>
                <h2 class="font-display font-bold text-3xl text-primary mb-6">Next 3 games</h2>
                <ul class="space-y-3">
                  {nextThreeFixtures.map(match => {
                    const isHome = match.homeAway === 'home';
                    return (
                      <li class={`overflow-hidden rounded-xl flex min-h-[120px] ${isHome ? 'bg-primary text-neutral' : 'bg-neutral border-2 border-primary text-primary'}`}>
                        <div class="w-1.5 flex-shrink-0" style={`background-color: var(--team-color)`} />
                        <div class="flex flex-col gap-2 p-5 flex-1">
                          <div class="flex items-center justify-between">
                            <span class={`font-display font-bold tabular text-lg`} style={isHome ? 'color: var(--team-color)' : 'color: var(--team-color)'}>{formatDate(match.date)}</span>
                            <span class={`text-xs uppercase tracking-wider font-bold px-2 py-1 rounded ${isHome ? 'bg-neutral/10 text-neutral/60' : 'bg-primary/10 text-primary/50'}`}>
                              {isHome ? 'HOME' : 'AWAY'}
                            </span>
                          </div>
                          <p class="font-display font-bold text-xl leading-tight">
                            {isHome ? 'vs ' : 'at '}{match.opponent}
                          </p>
                          <div class="mt-auto flex flex-wrap items-center gap-1.5">
                            {match.broadcast.length > 0
                              ? match.broadcast.map(b => <Broadcaster name={b} />)
                              : <span class={`text-xs ${isHome ? 'text-neutral/60' : 'text-muted'}`}>Broadcast TBD</span>
                            }
                          </div>
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </div>
            )}

            {lastThreeResults.length > 0 && (
              <div>
                <h2 class="font-display font-bold text-3xl text-primary mb-6">Last 3 results</h2>
                <ul class="space-y-3">
                  {lastThreeResults.map(match => {
                    const badge = resultBadge(match);
                    return (
                      <li class="bg-neutral border-2 border-primary p-5 rounded-xl flex flex-col gap-2 min-h-[120px]">
                        <div class="flex items-center justify-between">
                          <span class="font-display font-bold tabular text-primary text-lg">{formatDate(match.date)}</span>
                          <div class="flex items-center gap-2">
                            <span class={`text-xs font-display font-bold px-2 py-1 rounded ${badge.color}`} style={badge.style ?? ''}>
                              {badge.label}
                            </span>
                            <span class="font-display font-bold tabular text-2xl text-primary">
                              {formatScore(match)}
                            </span>
                          </div>
                        </div>
                        <p class="font-display font-bold text-xl text-primary leading-tight">
                          {match.homeAway === 'home' ? 'vs ' : 'at '}{match.opponent}
                        </p>
                        <span class="text-sm text-muted mt-auto">{match.venue}</span>
                      </li>
                    );
                  })}
                </ul>
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- Full schedule -->
    {upcomingMatches.length > 0 && (
      <section class="bg-neutral py-16">
        <div class="max-w-5xl mx-auto px-6">
          <div class="flex items-center gap-3 mb-2">
            <h2 class="font-display font-bold text-3xl text-primary">Full remaining schedule</h2>
            <button
              id="schedule-toggle"
              aria-expanded="false"
              aria-controls="schedule-list"
              aria-label="Toggle full schedule"
              class="hover:opacity-70 transition-opacity"
              style="color: var(--team-color)"
            >
              <span id="schedule-toggle-icon" class="block text-4xl leading-none" style="transition: transform 0.3s ease;">↓</span>
            </button>
          </div>
          <p class="text-muted text-sm mb-6">All upcoming {team.name} games this season.</p>
          <ul id="schedule-list" aria-hidden="true" inert class="space-y-3 overflow-hidden" style="max-height: 0; transition: max-height 0.4s ease;">
            {upcomingMatches.map(match => {
              const isHome = match.homeAway === 'home';
              return (
                <li class={`overflow-hidden rounded-xl flex min-h-[120px] ${isHome ? 'bg-primary text-neutral' : 'bg-neutral border-2 border-primary text-primary'}`}>
                  <div class="w-1.5 flex-shrink-0" style="background-color: var(--team-color)" />
                  <div class="flex flex-col gap-2 p-5 flex-1">
                    <div class="flex items-center justify-between">
                      <span class="font-display font-bold tabular text-lg" style="color: var(--team-color)">{formatDate(match.date)}</span>
                      <span class={`text-xs uppercase tracking-wider font-bold px-2 py-1 rounded ${isHome ? 'bg-neutral/10 text-neutral/60' : 'bg-primary/10 text-primary/50'}`}>
                        {isHome ? 'HOME' : 'AWAY'}
                      </span>
                    </div>
                    <p class="font-display font-bold text-xl leading-tight">
                      {isHome ? 'vs ' : 'at '}{match.opponent}
                    </p>
                    <div class="mt-auto flex flex-col gap-0.5">
                      <span class={`text-sm ${isHome ? 'text-neutral/70' : 'text-muted'}`}>{match.venue}</span>
                      <span class={`text-sm ${isHome ? 'text-neutral/50' : 'text-muted/70'}`}>
                        {match.broadcast.length > 0 ? match.broadcast.join(', ') : 'Broadcast TBD'}
                      </span>
                    </div>
                    {team.ticketsUrl && isHome && (
                      <a
                        href={team.ticketsUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="self-start text-xs font-bold text-primary px-3 py-1 rounded-full hover:opacity-80 transition-opacity mt-1"
                        style="background-color: var(--team-color)"
                      >
                        Get tickets →
                      </a>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )}

    <!-- Closer -->
    <section class="bg-neutral py-12">
      <div class="max-w-5xl mx-auto px-6">
        <p class="text-sm text-muted leading-relaxed max-w-2xl">
          Data sourced from <a href="https://wnba.com" target="_blank" rel="noopener noreferrer" class="font-bold hover:underline" style="color: var(--team-color)">wnba.com</a> and <a href={team.officialUrl} target="_blank" rel="noopener noreferrer" class="font-bold hover:underline" style="color: var(--team-color)">{new URL(team.officialUrl).hostname.replace('www.', '')}</a>. If you spot something wrong, email <a href="mailto:ro@standd.fan" class="font-bold hover:underline" style="color: var(--team-color)">ro@standd.fan</a>.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  const btn = document.getElementById('schedule-toggle');
  const list = document.getElementById('schedule-list') as HTMLElement | null;
  const icon = document.getElementById('schedule-toggle-icon') as HTMLElement | null;

  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    if (list) {
      list.style.maxHeight = expanded ? '0' : `${list.scrollHeight}px`;
      list.setAttribute('aria-hidden', String(expanded));
      if (expanded) { list.setAttribute('inert', ''); } else { list.removeAttribute('inert'); }
    }
    if (icon) {
      icon.style.transform = expanded ? '' : 'rotate(180deg)';
    }
  });
</script>
